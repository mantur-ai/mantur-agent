+      await assert.rejects(operation, (error) => error instanceof AudioFinalizationError
+        && error.stage === 'encode' && error.cleanupStatus === 'succeeded');
+      assert.equal(videoAttempts, 1, 'Final audio failure must not enter hardware video retry');
+      await assert.rejects(readFile(output), { code: 'ENOENT' });
+      observations.push({ name, rejected: 'encode', videoAttempts });
+      console.log(`audio matrix: ${name} passed`);
+      return;
+    }
+    const rendered = await operation;
+    if (hardware) assert.equal(rendered.encoder.id, 'h264_videotoolbox', 'Hardware case must actually use VideoToolbox');
+    const streams = (await probe(output)).streams;
+    const video = streams.find((stream) => stream.codec_type === 'video');
+    const audio = streams.find((stream) => stream.codec_type === 'audio');
+    const frameCount = range ? range[1] - range[0] + 1 : fps * 2;
+    assert.equal(Number(video.nb_frames), frameCount);
+    assert.equal(Boolean(audio), !muted, 'Preserve fixed 4.0.509 audio-track semantics');
+    if (muted) { assert.deepEqual(stages, []); observations.push({ name, audio: false }); }
+    else {
+      assert.deepEqual(stages, ['preflight', 'render', 'encode']);
+      const packets = (info) => info.packets.map(({ pts, dts, duration, size, flags, data_hash }) => ({ pts, dts, duration, size, flags, data_hash }));
