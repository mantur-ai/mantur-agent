+      const freezeCall = await poll();
+      assert.equal(freezeCall?.name, 'mantur_shutdown');
+      assert.equal(broker.settleEditorCall(freezeCall!.id, 'applied', { phase: 'freeze' }, capability), true);
+      await freezing;
+      const flushing = broker.requestEditorShutdown('flush', 1000);
+      const observed = flushing.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
