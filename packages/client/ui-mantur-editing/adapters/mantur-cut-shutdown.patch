+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { patchRemotionShutdown } from './patch-remotion-shutdown.mjs';
+
+const require = createRequire(import.meta.url);
+for (const file of ['browser/BrowserRunner.js', 'esm/index.mjs']) {
+  const installed = await readFile(join(dirname(require.resolve('@remotion/renderer')), file), 'utf8');
+  const patched = patchRemotionShutdown(installed);
+  assert.equal(patchRemotionShutdown(patched), patched);
+  const original = patched.replace(
+    /^ +const manturProcessAndPipesClosed = new Promise\(\(resolve\) => \{\n +proc.once\("close", \(\) => resolve\(\)\);\n +\}\);\n/m, '',
+  ).replace(/(\n +closeProcess),\n +manturProcessAndPipesClosed(,?)/, '$1$2');
+  assert.equal(patchRemotionShutdown(original), patched);
+  assert.throws(() => patchRemotionShutdown(`${original}\n`), /Unrecognized Remotion/);
+  assert(patched.indexOf('proc.once("close"') < patched.indexOf('await waitForWSEndpoint('));
+}
+console.log('Remotion patch: original and patched hashes, idempotence and unknown-source rejection passed');
