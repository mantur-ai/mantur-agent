+/** Real AAC video clip timing regression; no GUI, credentials, or browser download. */
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { mkdtemp, mkdir, writeFile, readFile, readdir, rm } from 'node:fs/promises';
+import { copyFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import http from 'node:http';
+import { tmpdir } from 'node:os';
+const editor = path.resolve(process.argv[2] ?? path.join(path.dirname(fileURLToPath(import.meta.url)), '..'));
+const require = createRequire(path.join(editor, 'package.json'));
+const { selectComposition } = require('@remotion/renderer');
+const { renderMediaOptimized, prebuildServeBundle } = await import(path.join(editor, 'remotion/render.mjs'));
+const ffmpeg = process.env.CC_TIMING_FFMPEG ?? require('ffmpeg-static');
+const ffprobe = process.env.CC_TIMING_FFPROBE ?? require('@ffprobe-installer/ffprobe').path;
+const exec = promisify(execFile);
+const outputRoot = process.env.CC_TIMING_EVIDENCE_DIR ?? tmpdir();
+const preserveEvidence = Boolean(process.env.CC_TIMING_EVIDENCE_DIR);
+await mkdir(outputRoot, { recursive: true });
+const root = await mkdtemp(path.join(outputRoot, 'video-aac-timing-'));
+try {
+  const browserExecutable = process.env.CC_BROWSER_EXECUTABLE;
+  assert(browserExecutable, 'Set CC_BROWSER_EXECUTABLE; no browser is downloaded');
+  const commands = [];
+  const run = async (command, args, options = {}) => {
+    try {
+      const result = await exec(command, args, { maxBuffer: 32 * 1024 * 1024, ...options });
+      commands.push({ command: [command, ...args], exit: 0, stderr: result.stderr.toString() });
+      return result.stdout;
+    } catch (e) {
+      commands.push({ command: [command, ...args], exit: e.code, stderr: e.stderr?.toString() });
+      throw e;
+    }
+  };
+  const probe = async (file) => JSON.parse(await run(ffprobe, ['-v', 'error', '-show_streams', '-show_packets', '-of', 'json', file]));
+  const decode = async (file) => {
+    const b = await run(ffmpeg, [
+      '-v', 'error', '-i', file, '-map', '0:a:0', '-ac', '1', '-ar', '48000', '-f', 'f32le', '-',
+    ], { encoding: 'buffer' });
+    return Float32Array.from({ length: b.length / 4 }, (_, i) => b.readFloatLE(i * 4));
+  };
+  const rms = (v, t, seconds = .005) => {
+    const n = Math.round(seconds * 48000), a = Math.round(t * 48000);
+    assert(a + n <= v.length);
+    let sum = 0;
+    for (let i = a; i < a + n; i++) sum += v[i] * v[i];
+    return Math.sqrt(sum / n);
+  };
+  const power = (v, t, f) => {
+    const a = Math.round(t * 48000), n = 960, c = 2 * Math.cos(2 * Math.PI * f / 48000);
+    let s1 = 0, s2 = 0;
+    for (let i = 0; i < n; i++) {
+      const x = v[a + i] * (.5 - .5 * Math.cos(2 * Math.PI * i / (n - 1)));
+      const s = x + c * s1 - s2;
+      s2 = s1;
+      s1 = s;
+    }
+    return Math.max(0, s1 * s1 + s2 * s2 - c * s1 * s2);
+  };
+  await mkdir(path.join(root, 'public'));
+  for (const [color, seconds, hz] of [['red', 2, 440], ['blue', 3, 660]])
+    await run(ffmpeg, [
+      '-v', 'error', '-f', 'lavfi', '-i', 'color=c=' + color + ':s=128x128:r=30:d=' + seconds,
+      '-f', 'lavfi', '-i', 'sine=frequency=' + hz + ':sample_rate=48000:duration=' + seconds,
+      '-c:v', 'libx264', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-shortest', path.join(root, color + '.mp4'),
+    ]);
+  const server = http.createServer(async (req, res) => {
+    try {
+      const name = new URL(req.url, 'http://localhost').pathname.slice(1);
+      if (!['red.mp4', 'blue.mp4', 'silent.mp4'].includes(name)) {
+        res.writeHead(404);
+        res.end();
+        return;
+      }
+      const b = await readFile(path.join(root, name));
+      res.setHeader('Content-Type', 'video/mp4');
+      res.setHeader('Access-Control-Allow-Origin', '*');
+      res.end(b);
+    } catch {
+      res.writeHead(500);
+      res.end();
+    }
+  });
+  await new Promise(r => server.listen(0, '127.0.0.1', r));
+  const origin = 'http://127.0.0.1:' + server.address().port;
+  const red = { kind: 'video', track: 'v1', sourceAssetId: 'red', name: 'red', src: origin + '/red.mp4', volume: 1, width: 128, height: 128 };
+  const blue = { ...red, sourceAssetId: 'blue', name: 'blue', src: origin + '/blue.mp4' };
+  const state = {
+    id: 'timing', name: 'Timing', order: 0, fps: 30, width: 128, height: 128, selectedId: null,
+    trackOrder: ['v1'], tracks: { v1: { kind: 'video' } },
+    items: [
+      { ...red, id: 'r1', startFrame: 0, durationInFrames: 30 },
+      { ...red, id: 'r2', startFrame: 30, srcInFrame: 30, durationInFrames: 30 },
+      { ...blue, id: 'b', startFrame: 60, durationInFrames: 90 },
+    ],
+  };
+  const observations = [];
+  try {
+    const serveUrl = await prebuildServeBundle(path.join(root, 'bundle'));
+    const inputProps = { state };
+    const composition = await selectComposition({ serveUrl, id: 'timeline', inputProps, browserExecutable });
+    for (const hardware of process.platform === 'darwin' ? [false, true] : [false]) {
+      const name = hardware ? 'hardware' : 'software';
+      const file = path.join(root, name + '.mp4');
+      const before = path.join(root, name + '-before.wav');
+      const stages = [];
+      const result = await renderMediaOptimized({
+        serveUrl, composition, inputProps, browserExecutable, codec: 'h264', outputLocation: file,
+        timeoutInMilliseconds: 120000, audioBinaries: { ffmpeg, ffprobe },
+        h264Profile: hardware
+          ? { id: 'h264_videotoolbox', label: 'VideoToolbox', hardware: true, transport: 'server' }
+          : undefined,
+        onAudioStage: stage => { stages.push(stage); if (stage === 'encode') {
+          const dir = path.dirname(file);
+          const entries = require('node:fs').readdirSync(dir);
+          const temp = entries.find(n => n.startsWith('.mantur-audio-'));
+          assert(temp);
+          copyFileSync(path.join(dir, temp, 'audio.wav'), before);
+        } }, logLevel: 'error' });
+      assert.deepEqual(stages, ['preflight', 'render', 'encode']);
+      if (hardware)
+        assert.equal(result.encoder.id, 'h264_videotoolbox');
+      const metadata = await probe(file);
+      const audio = metadata.streams.find(s => s.codec_type === 'audio'), video = metadata.streams.find(s => s.codec_type === 'video');
+      assert.equal(Number(video.nb_frames), 150);
+      assert.equal(Number(audio.sample_rate), 48000);
+      assert.equal(Number(audio.duration_ts), 240000);
+      assert.equal(Number(audio.start_pts), 0);
+      const frameBytes = 16 * 9 * 3;
+      const pixels = await run(ffmpeg, [
+        '-v', 'error', '-i', file, '-map', '0:v:0', '-vf', 'scale=16:9:flags=area',
+        '-fps_mode', 'passthrough', '-pix_fmt', 'rgb24', '-f', 'rawvideo', '-',
+      ], { encoding: 'buffer' });
+      assert.equal(pixels.length, 150 * frameBytes);
+      for (let frame = 0; frame < 150; frame++) {
+        let red = 0, blue = 0;
+        for (let i = 0; i < frameBytes; i += 3) {
+          red += pixels[frame * frameBytes + i];
+          blue += pixels[frame * frameBytes + i + 2];
+        }
+        assert(frame < 60 ? red / 144 > 200 && blue / 144 < 20 : blue / 144 > 200 && red / 144 < 20, name + ' unexpected picture at frame ' + frame);
+      }
+      const pts = metadata.packets.filter(p => p.codec_type === 'video').map(p => Number(p.pts_time)).sort((a, b) => a - b);
+      assert.equal(pts[60], 2);
+      const firstPacket = metadata.packets.find(p => p.codec_type === 'audio');
+      assert(firstPacket.pts < 0);
+      assert(firstPacket.side_data_list?.some(s => s.skip_samples > 0));
+      const pre = await decode(before), post = await decode(file);
+      const levels = {};
+      for (const t of [0, .005, .995, 1, 1.005, 1.995, 2, 2.005, 4.99, 4.995]) {
+        levels[t] = { pre: rms(pre, t), post: rms(post, t) };
+        assert(levels[t].pre > .03, name + ' PCM gap at ' + t);
+        assert(levels[t].post > .03, name + ' AAC gap at ' + t);
+      }
+      assert(power(post, 1.98, 440) > power(post, 1.98, 660) * 100);
+      assert(power(post, 2, 660) > power(post, 2, 440) * 100);
+      assert(!((await readdir(root)).some(n => n.startsWith('.mantur-audio-'))));
+      observations.push({ name, file, stages, levels, audioSamples: Number(audio.duration_ts), frames: Number(video.nb_frames), encoder: result.encoder?.id ?? 'software' });
+    }
+    await run(ffmpeg, ['-v', 'error', '-i', path.join(root, 'red.mp4'), '-map', '0:v:0', '-c', 'copy', path.join(root, 'silent.mp4')]);
+    for (const variant of ['no-audio-track', 'muted', 'zero-volume']) {
+      const clip = { ...red, id: 'solo', startFrame: 0, durationInFrames: 60,
+        src: origin + (variant === 'no-audio-track' ? '/silent.mp4' : '/red.mp4'),
+        volume: variant === 'zero-volume' ? 0 : 1 };
+      const silentState = { ...state, items: [clip], tracks: { v1: { kind: 'video', muted: variant === 'muted' } } };
+      const silentProps = { state: silentState };
+      const silentComposition = await selectComposition({ serveUrl, id: 'timeline', inputProps: silentProps, browserExecutable });
+      const file = path.join(root, variant + '.mp4');
+      await renderMediaOptimized({ serveUrl, composition: silentComposition, inputProps: silentProps, browserExecutable,
+        codec: 'h264', outputLocation: file, timeoutInMilliseconds: 120000, audioBinaries: { ffmpeg, ffprobe }, logLevel: 'error' });
+      const metadata = await probe(file);
+      assert.equal(Number(metadata.streams.find(s => s.codec_type === 'video').nb_frames), 60);
+      const silentAudio = await decode(file);
+      assert(silentAudio.every(value => value === 0), variant + ' must retain the pinned silent-track behavior');
+      observations.push({ name: variant, file, frames: 60, silent: true });
+    }
+    await writeFile(path.join(root, 'result.json'), JSON.stringify({ ok: true, observations, commands }, null, 2));
+    console.log(JSON.stringify({ ok: true, root, observations }));
+  }
+  catch (error) {
+    await writeFile(path.join(root, 'result.json'), JSON.stringify({ ok: false, error: String(error), stack: error.stack, observations, commands }, null, 2));
+    throw error;
+  }
+  finally {
+    await new Promise(r => server.close(r));
+  }
+} finally {
+  if (!preserveEvidence) await rm(root, { recursive: true, force: true });
+}
