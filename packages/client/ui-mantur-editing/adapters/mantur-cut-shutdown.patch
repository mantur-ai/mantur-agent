+import assert from 'node:assert/strict';
+import { setImmediate as tick } from 'node:timers/promises';
+import { withAbortableCompositionSelection } from './render.mjs';
+import { assertRenderShutdownConfirmed } from './render-shutdown.mjs';
+
+// Merely importing the installed renderer has not acquired a rendering subprocess.
+assert.doesNotThrow(assertRenderShutdownConfirmed);
+const released = Promise.withResolvers();
+const closing = Promise.withResolvers();
+let closes = 0;
+const closeError = new Error('render browser close failed');
+const rendering = withAbortableCompositionSelection({
+  selectionOptions: {},
+  openBrowserImpl: async () => ({ close: async () => { closes += 1; closing.resolve(); await released.promise; throw closeError; } }),
+  selectCompositionImpl: async () => ({}),
+  run: async () => 'rendered',
+});
+let finished = false;
+const rejected = assert.rejects(rendering, (error) => error === closeError).then(() => { finished = true; });
+await closing.promise;
+await tick(); assert.equal(finished, false, 'render result cannot precede browser cleanup');
+released.resolve(); await rejected;
+assert.equal(closes, 1);
+assert.throws(assertRenderShutdownConfirmed, (error) => error instanceof AggregateError && error.errors.includes(closeError));
+
+const abort = new AbortController();
+const original = new Error('composition selection failed');
+const earlierClose = new Error('abort-triggered browser close failed');
+let abortCloses = 0;
+await assert.rejects(withAbortableCompositionSelection({
+  signal: abort.signal, selectionOptions: {},
+  openBrowserImpl: async () => ({ close: async () => { abortCloses += 1; throw earlierClose; } }),
+  selectCompositionImpl: async () => { abort.abort(original); throw original; },
+  run: async () => assert.fail('failed selection must not render'),
+}), (error) => error instanceof AggregateError && error.errors[0] === original && error.errors[1] === earlierClose);
+assert.equal(abortCloses, 1, 'finally retains the original abort-triggered close promise');
+console.log('render shutdown: unused instance, pending close, failed close and original failure retention passed');
