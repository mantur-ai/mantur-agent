+      });
+      post.on('error', reject); post.write(bytes.subarray(0, 32));
+      if (scenario !== 'cutoff') post.end(bytes.subarray(32));
+    });
+    // Only cleanup can abort this test-owned request after an earlier assertion failed.
+    void response.catch(() => {});
+    await admitted.promise;
+    if (scenario === 'post' || scenario === 'dedupe' || scenario === 'unsupported-delete') {
+      const uploaded = await response; assert.equal(uploaded.status, 200, JSON.stringify(uploaded.body));
+      if (scenario === 'post') {
+        const frames = await fetch(`${origin}/api/extract-frames`, { method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify({ src: uploaded.body.path, sourceTimesMs: [0] }) });
+        assert.equal(frames.status, 200); const grid = await frames.json() as { base64: string; sampleCount: number };
+        assert.equal(grid.sampleCount, 1); assert.equal(Buffer.from(grid.base64, 'base64').subarray(0, 2).toString('hex'), 'ffd8');
+      }
+      if (scenario === 'dedupe') {
+        const again = await fetch(url, { method: 'POST', headers: { Origin: origin, 'Content-Type': 'video/mp4' }, body: bytes });
+        assert.equal(again.status, 200); const duplicate = await again.json() as { created: boolean; contentHash: string };
+        assert.equal(duplicate.created, false); assert.equal(duplicate.contentHash, hash);
+      }
+      if (scenario === 'unsupported-delete') {
+        const deleted = await fetch(`${origin}/upload?name=local-test.mp4`, { method: 'DELETE', headers: { Origin: origin } });
+        assert.equal(deleted.status, 200);
+      }
+    }
+    if (scenario === 'copy-close' || scenario === 'close-failure') await closeEntered.promise;
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const freezeAck = Promise.withResolvers<void>();
+    const stopping = owner.stopForShutdown();
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const pump = (async () => {
+      try {
+        for (const phase of ['freeze', 'flush']) {
+          const call = await broker.nextEditorCall('project', 'editor', 'revision', pollAbort.signal, capability);
+          if (pollAbort.signal.aborted) return;
+          assert.equal(call?.arguments.phase, phase);
+          broker.settleEditorCall(call!.id, 'applied', { phase }, capability);
+          if (phase === 'freeze') freezeAck.resolve();
+          else await broker.unregisterEditor('project', 'editor', capability);
+        }
+      } catch (error) { if (!pollAbort.signal.aborted) throw error; }
+    })();
+    void pump.catch(() => {});
+    await freezeAck.promise; await tick();
+    let finished = false; void observed.then(() => { finished = true; }); await tick();
+    if (scenario === 'cutoff' || scenario === 'copy-close' || scenario === 'close-failure') {
+      assert.equal(finished, false, 'accepted upload must retain its body and file-handle completion');
+      assert.equal((await fetch(url, { method: 'POST', headers: { Origin: origin }, body: bytes })).status, 503);
+    }
+    if (scenario === 'cutoff') post!.end(bytes.subarray(32));
+    closeRelease.resolve();
+    const result = await response;
+    if (scenario === 'close-failure') {
+      assert.equal(result.status, 500); assert.match(String(result.body.error), /upload file close refused/);
+    } else {
+      assert.equal(result.status, 200, JSON.stringify(result.body)); assert.equal(result.body.contentHash, hash);
+      if (scenario !== 'unsupported-delete') {
+        assert.deepEqual(await readFile(finalPath), bytes);
+        assert((await readdir(uploadDir())).every(name => !name.endsWith('.part')));
+      }
+    }
+    assert.deepEqual(await readFile(source), bytes);
+    const stopped = await observed; pollAbort.abort(); await pump;
+    assert.equal(stopped.ok, scenario !== 'close-failure' && scenario !== 'unsupported-delete', String(stopped.ok ? '' : stopped.error));
+    if (stopped.ok) await owner.finishTransportShutdown();
+    else {
+      assert.match(String(stopped.error), scenario === 'unsupported-delete' ? /unconfirmed producers: openchatcut-upload/ : /failed; shutdown is unconfirmed/);
+      assert.strictEqual(stopping, owner.stopForShutdown());
+    }
+  } finally {
+    pollAbort.abort(); closeRelease.resolve(); post?.destroy();
+    fsPromises.link = nativeLink; fsPromises.open = nativeOpen; syncBuiltinESMExports();
+    await Promise.all(handles.map(close => close()));
+    if (server) await new Promise<void>((resolve, reject) => server!.close(error => error ? reject(error) : resolve()));
+    await rm(root, { recursive: true, force: true });
+  }
+}
diff --git a/server/plugins/mantur-shutdown.ts b/server/plugins/mantur-shutdown.ts
new file mode 100644
index 0000000..6b0cf21
--- /dev/null
+++ b/server/plugins/mantur-shutdown.ts
@@ -0,0 +1,172 @@
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { ShutdownWork } from '../../shared/shutdown-work.ts';
+import { isIsolatedDevProfile } from '../runtime-profile.ts';
+import { Server } from 'node:http';
+import type { Connect, Plugin, ViteDevServer } from 'vite';
+import {
+  editorRequests, editorCallbacks, recordUnconfirmedEditorProducer,
+  stopEditorMaintenanceForShutdown, stopEditorMediaProcessesForShutdown,
+} from '../shutdown-runtime.ts';
+import { stopGenerationJobsForShutdown } from './generation-job-lifecycle.ts';
+import { stopProjectStoreForShutdown } from './project-store.ts';
+import {
+  requestEditorShutdown, stopEditorCallsForShutdown, stopEditorRegistrationsForShutdown,
+} from '../external-agent/broker.ts';
+import { stopMcpRetirementsForShutdown } from '../external-agent/mcp.ts';
+import { flushServerRunPersistence } from '../agent-runs/store.ts';
+import { assertRenderShutdownConfirmed } from '../../remotion/render-shutdown.mjs';
+
+declare module 'node:http' {
+  interface Server {
+    /** Actual shared editor owner, consumed by the development and packaged Host adapters. */
+    manturShutdown?: { stopForShutdown(): Promise<void>; finishTransportShutdown(): Promise<void> };
+  }
+}
+
+const OWNED_PLUGINS = new Set([
+  'openchatcut-request-shape-gate', 'openchatcut-cross-origin-isolation',
+  'mantur-project-media', 'openchatcut-project-store', 'openchatcut-external-agent',
+  'openchatcut-export', 'openchatcut-export-stage', 'openchatcut-export-destination',
+  'openchatcut-generation-progress', 'openchatcut-media-preview', 'openchatcut-settings',
+  'openchatcut-extract-frames',
+]);
+
+function requestPath(mount: string, req: IncomingMessage): string {
+  const pathname = (req.url ?? '/').split('?')[0];
+  return mount && !pathname.startsWith(mount) ? `${mount}${pathname === '/' ? '' : pathname}` : pathname;
+}
+
+function callbackRoute(pathname: string, req: IncomingMessage): boolean {
+  if (pathname.startsWith('/api/project-store/')) return true;
+  if (pathname === '/api/external-mcp/mcp') return req.method === 'DELETE' || req.method === 'GET';
+  return ['/poll', '/cancellation', '/result', '/unregister'].some((path) => pathname === `/api/external-agent${path}`);
+}
+
+function ownedCatalogRequest(name: string, pathname: string, req: IncomingMessage): boolean {
+  return req.method === 'GET' && (
+    name === 'openchatcut-extension-store' && (pathname === '/api/plugins' || pathname === '/api/plugins/')
+    || name === 'openchatcut-model-packs' && pathname === '/api/model-packs'
+  );
+}
+
+function ownedLocalUploadRequest(name: string, pathname: string, req: IncomingMessage): boolean {
+  return name === 'openchatcut-upload' && pathname === '/upload'
+    && (req.method === 'POST' || req.method === 'PUT') && isIsolatedDevProfile();
+}
+
+function refuse(res: ServerResponse): void {
+  res.statusCode = 503;
+  res.setHeader('Content-Type', 'application/json');
+  res.end(JSON.stringify({ error: 'Editor is shutting down; new work is not accepted' }));
+}
+
+/** One editor process: native MCP cutoff, browser work, backend work, then authoritative saves. */
+export class ManturEditorShutdown {
+  private phase: 'open' | 'preparing' | 'draining' | 'sealed' = 'open';
+  private stopping: Promise<void> | undefined;
+  private readonly transports = new ShutdownWork('Editor MCP transport closure');
+  private transportClosing: Promise<void> | undefined;
+
+  plugin(): Plugin {
+    return {
+      name: 'mantur-editor-shutdown',
+      configureServer: (server) => {
+        if (!(server.httpServer instanceof Server)) throw new Error('Editor shutdown requires its owning HTTP/1 server');
+        server.httpServer.manturShutdown = this;
+        // Both hosts place their provider proxy after this admission gate. Its remote job is not drain-owned.
+        server.middlewares.use('/assemblyai', this.ownRequest('assemblyai-proxy', '/assemblyai', (_req, _res, next) => {
+          recordUnconfirmedEditorProducer('AssemblyAI proxy remote work');
+          next();
+        }));
+      },
+    };
+  }
+
+  stopForShutdown(): Promise<void> {
+    if (this.stopping) return this.stopping;
+    this.phase = 'preparing';
+    this.stopping = (async () => {
+      const budget = Number(process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS);
+      if (!Number.isSafeInteger(budget) || budget < 1) throw new Error('Editor shutdown requires its Host drain deadline');
+      await stopEditorCallsForShutdown();
+      // Browser input stops before its accepted operations finish; their late backend submissions remain valid.
+      await requestEditorShutdown('freeze', budget);
+      this.phase = 'draining';
+      await editorRequests.stop();
+      await stopGenerationJobsForShutdown();
+      await stopEditorMaintenanceForShutdown();
+      await requestEditorShutdown('flush', budget);
+      this.phase = 'sealed';
+      await editorCallbacks.stop();
+      await stopEditorRegistrationsForShutdown();
+      await stopMcpRetirementsForShutdown();
+      await flushServerRunPersistence();
+      await stopProjectStoreForShutdown();
+      await stopEditorMediaProcessesForShutdown();
+      assertRenderShutdownConfirmed();
+    })();
+    return this.stopping;
+  }
+
+  /** After the Host closes its drained MCP client, await the original GET/DELETE handlers before HTTP closure. */
+  finishTransportShutdown(): Promise<void> {
+    return this.transportClosing ??= (async () => {
+      await this.stopForShutdown();
+      await this.transports.stop();
+    })();
+  }
+
+  /** Preserve each route's original promise, including work after its HTTP response is sent. */
+  ownPlugin(plugin: Plugin): Plugin {
+    const configure = plugin.configureServer;
+    if (!configure) return plugin;
+    const handler = typeof configure === 'function' ? configure : configure.handler;
+    const ownRequest = this.ownRequest.bind(this);
+    const configureServer: NonNullable<Plugin['configureServer']> = function (server) {
+      const middlewares = new Proxy(server.middlewares, {
+        get(target, key, receiver) {
+          if (key !== 'use') return Reflect.get(target, key, receiver);
+          return (pathOrHandler: string | Connect.NextHandleFunction, callback?: Connect.NextHandleFunction) => {
+            const mount = typeof pathOrHandler === 'string' ? pathOrHandler : '';
+            const route = typeof pathOrHandler === 'function' ? pathOrHandler : callback;
+            if (!route) throw new Error(`Editor plugin ${plugin.name} registered no middleware`);
+            const wrapped = ownRequest(plugin.name, mount, route);
+            return mount ? target.use(mount, wrapped) : target.use(wrapped);
+          };
+        },
+      });
+      const owned = new Proxy(server, { get: (target, key, receiver) => key === 'middlewares' ? middlewares : Reflect.get(target, key, receiver) });
+      return handler.call(this, owned as ViteDevServer);
+    };
+    return { ...plugin, configureServer: typeof configure === 'function' ? configureServer : { ...configure, handler: configureServer } };
+  }
+
+  private ownRequest(name: string, mount: string, handler: Connect.NextHandleFunction): Connect.NextHandleFunction {
+    return (req, res, next) => {
+      const pathname = requestPath(mount, req);
+      // The Host closes its native transport after the editor acknowledges durable shutdown.
+      const transport = name === 'openchatcut-external-agent' && pathname === '/api/external-mcp/mcp'
+        && (req.method === 'GET' || req.method === 'DELETE');
+      const transportDelete = transport && req.method === 'DELETE';
+      const callback = callbackRoute(pathname, req);
+      if (this.phase === 'sealed' && !transportDelete || this.phase === 'draining' && !callback
+        || this.phase === 'preparing' && name === 'openchatcut-external-agent' && !callback) {
+        refuse(res); return;
+      }
+      const work = transport ? this.transports : callback ? editorCallbacks : editorRequests;
+      const operation = work.admit(async () => {
+        let delegated = false;
+        // Connect types handlers as returning void; feature routes may return their actual async work.
+        const completion: unknown = handler(req, res, (error) => { delegated = true; next(error); });
+        if (!delegated) {
+          if (!OWNED_PLUGINS.has(name) && !ownedCatalogRequest(name, pathname, req) && !ownedLocalUploadRequest(name, pathname, req)) recordUnconfirmedEditorProducer(`${name} ${mount || '/'}`);
+          if (completion === undefined && !res.writableEnded) recordUnconfirmedEditorProducer(`${name}: asynchronous handler without completion`);
+        }
+        await completion;
+        if (!delegated && res.statusCode >= 400) work.recordFailure(new Error(`${name} ${req.method ?? 'UNKNOWN'} ${pathname} returned HTTP ${res.statusCode}`));
+      });
+      void operation.catch(() => { if (!res.headersSent) refuse(res); });
+      return operation;
+    };
+  }
+}
