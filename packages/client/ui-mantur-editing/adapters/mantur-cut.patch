+    const output = path.join(root, `${name}.mp4`);
+    const before = path.join(root, `${name}-video.mp4`);
+    let renderedVideo;
+    let videoAttempts = 0;
+    const stages = [];
+    const profile = hardware ? { id: 'h264_videotoolbox', label: 'VideoToolbox', hardware: true, transport: 'server' } : undefined;
+    let audioFfmpeg = ffmpeg;
+    if (failAudio) {
+      audioFfmpeg = path.join(root, 'fail-audio');
+      await writeFile(audioFfmpeg, `#!${process.execPath}\nif(process.argv.includes('encoder=aac'))console.log('Encoder aac [AAC]');else{console.error('hardware encoder failed: audio sentinel');process.exitCode=17;}\n`, { mode: 0o700 });
