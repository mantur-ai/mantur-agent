@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { stopEditorBackgroundForShutdown } from '../../editor/mantur-shutdown';
+import type { ViteDevServer } from 'vite';
+import { pruneSemanticVectors, searchSemanticVectorsRemote } from './vectorStore';
+
+const globals = globalThis as unknown as { window?: unknown; location?: unknown };
+const originalWindow = globals.window;
+const originalLocation = globals.location;
+const originalFetch = globalThis.fetch;
+const root = await mkdtemp(join(tmpdir(), 'mantur-vector-capability-'));
+process.env.OPENCHATCUT_DATA_DIR = root;
+delete process.env.OPENCHATCUT_SQLITE_STORE;
+const { createMiniConnect } = await import('../../../desktop/mini-connect.ts');
+const { projectStorePlugin } = await import('../../../server/plugins/project-store-plugin.ts');
+const { ManturEditorShutdown } = await import('../../../server/plugins/mantur-shutdown.ts');
+const { editorCallbacks } = await import('../../../server/shutdown-runtime.ts');
+const { executeProjectStoreRequest } = await import('../../../server/project-store-transport.ts');
+const { isProjectStoreRequest } = await import('../../../shared/project-store-validation.ts');
+const app = createMiniConnect(error => { throw error; });
+const server = createServer((req, res) => app.handle(req, res));
+try {
+  const plugin = new ManturEditorShutdown().ownPlugin(projectStorePlugin());
+  const hook = plugin.configureServer!;
+  const configure = typeof hook === 'function' ? hook : hook.handler;
+  await configure.call({} as never, { middlewares: app, httpServer: server, config: { logger: { error() {} } } } as unknown as ViteDevServer);
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address(); assert(address && typeof address !== 'string');
+  const origin = `http://127.0.0.1:${address.port}`;
+  const requests: string[] = [];
+  globals.window = {};
+  globals.location = { protocol: 'http:' };
+  globalThis.fetch = (input, init) => {
+    const url = new URL(String(input), origin);
+    requests.push(url.pathname);
+    return originalFetch(url, { ...init, headers: { ...init?.headers, Origin: origin, 'Sec-Fetch-Site': 'same-origin' } });
+  };
+  assert.equal(isProjectStoreRequest({ operation: 'semantic-vectors-status' }), true);
+  assert.equal(isProjectStoreRequest({ operation: 'semantic-vectors-status', scopeId: 'extra' }), false);
+  await assert.rejects(executeProjectStoreRequest({ operation: 'semantic-vectors-status', scopeId: 'extra' }), /invalid project store request/);
+  assert.deepEqual(await executeProjectStoreRequest({ operation: 'semantic-vectors-status' }), { semanticVectorsAvailable: false });
+  await pruneSemanticVectors('fresh-project', new Set());
+  assert.deepEqual(requests, ['/api/project-store/semantic-vectors/status'], 'new JSON project must not send an unsupported remote prune');
+  assert.equal(await searchSemanticVectorsRemote('fresh-project', new Float32Array(512)), null);
+  assert.equal(requests.length, 2, 'each operation resolves current capability instead of permanently caching absence');
+  let mutationCalls = 0;
+  let availability: unknown = false;
+  globals.window = { openChatCutDesktop: { projectStore: async (request: { operation: string }) => {
+    if (request.operation === 'semantic-vectors-status') return { semanticVectorsAvailable: availability };
+    mutationCalls += 1;
+    return { semanticVectors: [] };
+  } } };
+  await pruneSemanticVectors('fresh-project', new Set());
+  assert.equal(mutationCalls, 0);
+  availability = true;
+  await pruneSemanticVectors('fresh-project', new Set());
+  assert.equal(mutationCalls, 1, 'an explicitly available index still receives the original operation');
+  availability = 'unknown';
+  await assert.rejects(pruneSemanticVectors('fresh-project', new Set()), /Invalid semantic-vector capability response/);
+  assert.equal(mutationCalls, 1);
+  globals.window = { openChatCutDesktop: { projectStore: async () => { throw new Error('capability request failed'); } } };
+  await assert.rejects(pruneSemanticVectors('fresh-project', new Set()), /capability request failed/);
+  assert.equal(mutationCalls, 1, 'a failed probe must not be treated as unavailable success');
+  const invalidPrune = await globalThis.fetch('/api/project-store/semantic-vectors/prune', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ operation: 'semantic-vectors-prune', scopeId: 'fresh-project', validAssetIds: [] }),
+  });
+  assert.equal(invalidPrune.status, 400, 'the server still rejects a real unsupported operation');
+  await assert.rejects(editorCallbacks.stop(), /callbacks failed; shutdown is unconfirmed/);
+  const probeEntered = Promise.withResolvers<void>();
+  const probeRelease = Promise.withResolvers<void>();
+  globals.window = { openChatCutDesktop: { projectStore: async () => {
+    probeEntered.resolve(); await probeRelease.promise; return { semanticVectorsAvailable: false };
+  } } };
+  const pendingPrune = pruneSemanticVectors('late-probe', new Set());
+  await probeEntered.promise;
+  const draining = stopEditorBackgroundForShutdown();
+  const rejected = assert.rejects(draining, /Browser editor background work failed/);
+  let finished = false;
+  void rejected.then(() => { finished = true; });
+  await tick(); assert.equal(finished, false, 'the earlier failures do not discard the accepted pending capability operation');
+  probeRelease.resolve(); await pendingPrune; await rejected;
+  console.log('vector capability: JSON HTTP/IPC, enabled routing, invalid/failed probe, pending drain and retained HTTP400 passed');
+} finally {
+  globalThis.fetch = originalFetch;
+  if (originalWindow === undefined) delete globals.window; else globals.window = originalWindow;
+  if (originalLocation === undefined) delete globals.location; else globals.location = originalLocation;
+  await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+  await rm(root, { recursive: true, force: true });
+}
