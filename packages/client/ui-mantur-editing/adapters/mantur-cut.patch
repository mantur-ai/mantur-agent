diff --git a/src/media/manturProjectMedia.ts b/src/media/manturProjectMedia.ts
new file mode 100644
index 0000000..915d78a
--- /dev/null
+++ b/src/media/manturProjectMedia.ts
@@ -0,0 +1,31 @@
+import type { AgentPathImportRequest, AgentPathImportResult } from '../../shared/directory-import';
+import type { ProjectMediaListing } from '../../shared/mantur-project-media';
+
+export function projectMediaEnabled(): boolean {
+  return typeof document !== 'undefined' && document.querySelector('meta[name="mantur-project-media"]')?.getAttribute('content') === 'enabled';
+}
+
+async function requestProjectMedia(body: object): Promise<unknown> {
+  const response = await fetch('/api/mantur/project-media', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+  });
+  const value = await response.json();
+  if (!response.ok) throw new Error(typeof value?.error === 'string' ? value.error : `Project media request failed (${response.status})`);
+  return value;
+}
+
+export async function listProjectMedia(path: string, offset = 0): Promise<ProjectMediaListing> {
+  const value = await requestProjectMedia({ action: 'list', path, offset }) as ProjectMediaListing;
+  if (typeof value?.root !== 'string' || typeof value.directory !== 'string' || !Array.isArray(value.entries)
+    || !value.entries.every(entry => typeof entry.path === 'string' && typeof entry.name === 'string'
+      && ['directory', 'video', 'audio', 'image', 'gif', 'svg'].includes(entry.kind))
+    || (value.nextOffset !== null && !Number.isSafeInteger(value.nextOffset))) throw new Error('Invalid project media listing');
+  return value;
+}
+
+export async function importProjectMedia(request: AgentPathImportRequest): Promise<AgentPathImportResult> {
+  const value = await requestProjectMedia({ action: 'import', ...request }) as AgentPathImportResult;
+  if (!Array.isArray(value?.imported) || !Array.isArray(value.errors) || !Array.isArray(value.unsupportedFiles)
+    || !Number.isSafeInteger(value.duplicateCount)) throw new Error('Invalid project media import result');
+  return value;
+}
