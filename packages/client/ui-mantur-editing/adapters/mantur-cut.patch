+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, readFile, readdir, realpath, rename, rm, stat, symlink, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { createServer } from 'vite';
+import type { AgentPathImportResult } from '../../shared/directory-import';
+import type { ProjectMediaListing } from '../../shared/mantur-project-media';
+
+const directory = await realpath(await mkdtemp(join(tmpdir(), 'mantur-project-media-')));
+const root = join(directory, 'project');
+const media = join(root, '剪辑', 'session-test', '素材');
+await mkdir(media, { recursive: true });
+await mkdir(join(root, 'shots'));
+await mkdir(join(root, '.hidden'));
+await mkdir(join(root, 'node_modules'));
+process.env.OPENCHATCUT_DEV_PROFILE_ID = randomUUID();
+process.env.OPENCHATCUT_DATA_DIR = join(root, '剪辑', 'session-test', '工程');
+process.env.MANTUR_CUT_MEDIA_DIR = media;
+process.env.MANTUR_CUT_PROJECT_DIR = root;
+const { manturProjectMediaPlugin } = await import('./mantur-project-media.ts');
+const { requestShapeGatePlugin } = await import('./request-shape-gate.ts');
+const { uploadPlugin } = await import('./upload.ts');
+const { ffmpegBin } = await import('../media-binaries.ts');
+const { resolveUploadFile } = await import('../media-dir.ts');
+const { deleteMediaReference } = await import('../media-references.ts');
+const clip = join(root, 'shots', '中文片段.mp4');
+execFileSync(ffmpegBin(), ['-v', 'error', '-f', 'lavfi', '-i', 'color=c=blue:s=160x90:r=25:d=1', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', clip], { timeout: 30000 });
+const original = await readFile(clip);
+await writeFile(join(root, 'notes.md'), 'not media');
+await symlink(directory, join(root, 'outside'));
+const server = await createServer({ configFile: false, plugins: [requestShapeGatePlugin(), manturProjectMediaPlugin(), uploadPlugin()], server: { host: '127.0.0.1', port: 0 } });
+await new Promise<void>(resolve => server.httpServer!.listen(0, '127.0.0.1', resolve));
+const address = server.httpServer!.address();
+assert.ok(address && typeof address !== 'string');
+const origin = `http://127.0.0.1:${address.port}`;
+async function request(body: object, requestOrigin = origin) {
+  return fetch(`${origin}/api/mantur/project-media`, { method: 'POST',
+    headers: { Origin: requestOrigin, 'Sec-Fetch-Site': 'same-origin', 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+  });
+}
+try {
+  assert.equal((await request({ action: 'list', path: '', offset: 0 }, 'https://example.com')).status, 403);
+  const listing = await (await request({ action: 'list', path: '', offset: 0 })).json() as ProjectMediaListing;
+  assert.deepEqual(listing.entries.map(entry => entry.name), ['shots']);
+  for (const path of ['..', 'outside', '剪辑', '.hidden', 'node_modules']) {
+    assert.equal((await request({ action: 'list', path, offset: 0 })).status, 400, path);
+  }
+  const args = { action: 'import', paths: ['shots/中文片段.mp4'], projectId: 'project-test', knownHashes: [] };
+  const imported = await (await request(args)).json() as AgentPathImportResult;
+  assert.deepEqual(imported.errors, []);
+  assert.equal(imported.imported.length, 1);
+  const file = imported.imported[0];
+  assert.equal(resolveUploadFile(file.storedName), clip, 'compatible clip references the original');
+  assert.deepEqual(await readFile(clip), original, 'source bytes remain unchanged');
+  assert.deepEqual(await readdir(media), ['.references'], 'no duplicate video is stored');
+  const served = await fetch(`${origin}${file.src}`);
+  assert.equal(served.status, 200);
+  assert.deepEqual(Buffer.from(await served.arrayBuffer()), original, 'media URL streams the original');
+  const repeated = await (await request({ ...args, knownHashes: [file.contentHash] })).json() as AgentPathImportResult;
+  assert.equal(repeated.duplicateCount, 1);
+  const moved = join(root, 'shots', 'moved.mp4');
+  await rename(clip, moved);
+  assert.equal(resolveUploadFile(file.storedName), null, 'moved source becomes offline');
+  const relocated = await (await request({ ...args, paths: ['shots/moved.mp4'] })).json() as AgentPathImportResult;
+  assert.equal(relocated.imported.length, 1);
+  assert.equal(resolveUploadFile(relocated.imported[0].storedName), moved);
+  await deleteMediaReference(media, relocated.imported[0].storedName);
+  assert.equal((await stat(moved)).size, original.length, 'removing a reference preserves the source');
+  const { execAgentPathImportTool } = await import('../../src/agent/tools/agent-path-import-tools.ts');
+  const nativeFetch = globalThis.fetch;
+  const originalDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  const added: Array<{ name: string }> = [];
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: { querySelector: () => ({ getAttribute: () => 'enabled' }) } });
+  globalThis.fetch = (input, init) => nativeFetch(new URL(String(input), origin), { ...init,
+    headers: { ...init?.headers, Origin: origin, 'Sec-Fetch-Site': 'same-origin' },
+  });
+  try {
+    const agentResult = await execAgentPathImportTool('import_asset', { path: 'shots/moved.mp4' }, {
+      getProjectId: () => 'project-test', getState: () => ({ fps: 25 }), getDoc: () => ({ assets: [] }),
+      commands: { addAsset: (asset: { name: string }) => added.push(asset) },
+    } as unknown as import('../../src/agent/context').AgentContext);
+    assert.equal(agentResult.ok, true);
+    assert.equal(added[0]?.name, 'moved.mp4', 'Agent tool uses the project endpoint and adds a real pool asset');
+  } finally {
+    globalThis.fetch = nativeFetch;
+    if (originalDocument) Object.defineProperty(globalThis, 'document', originalDocument);
+    else Reflect.deleteProperty(globalThis, 'document');
+  }
+  const rejected = await (await request({ ...args, paths: [join(directory, 'unrelated.mp4')] })).json() as AgentPathImportResult;
+  assert.equal(rejected.imported.length, 0);
+  assert.equal(rejected.errors.length, 1);
+  console.log('PASS project media: scoped listing, origin/path checks, direct streaming, deduplication, offline relocation, source-preserving removal.');
+} finally {
+  await server.close();
+  await rm(directory, { recursive: true, force: true });
+}
diff --git a/server/plugins/mantur-terminal-draft.verify.ts b/server/plugins/mantur-terminal-draft.verify.ts
