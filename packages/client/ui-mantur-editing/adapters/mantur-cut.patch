@@ -0,0 +1,168 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, readFile, realpath, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { createServer } from 'vite';
+import type { AgentContext } from '../../src/agent/context';
+import type { StoredExternalProposal } from '../../src/persist/externalProposalStore';
+
+const directory = await realpath(await mkdtemp(join(tmpdir(), 'mantur-import-session-')));
+const root = join(directory, 'project');
+await mkdir(join(root, 'shots'), { recursive: true });
+const env = {
+  OPENCHATCUT_DEV_PROFILE_ID: randomUUID(), OPENCHATCUT_DATA_DIR: join(directory, 'data'),
+  MANTUR_CUT_MEDIA_DIR: join(directory, 'media'), MANTUR_CUT_PROJECT_DIR: root,
+};
+const previousEnv = Object.fromEntries(Object.keys(env).map(key => [key, process.env[key]]));
+Object.assign(process.env, env);
+const { manturProjectMediaPlugin } = await import('./mantur-project-media');
+const { requestShapeGatePlugin } = await import('./request-shape-gate');
+const { ffmpegBin } = await import('../media-binaries');
+const { ExternalBridgeRuntime } = await import('../../src/agent/external-bridge-runtime');
+const { makeDraft } = await import('../../src/editor/store');
+const { INITIAL } = await import('../../src/editor/initial');
+const { docFromTimeline } = await import('../../src/persist/projectStore');
+const { revisionOf } = await import('../../src/agent/external-edit-session');
+const sourceBytes = new Map<string, Buffer>();
+for (const [name, color] of [['A', 'red'], ['B', 'blue'], ['C', 'green']]) {
+  const file = join(root, 'shots', `${name}.mp4`);
+  execFileSync(ffmpegBin(), ['-v', 'error', '-n', '-f', 'lavfi', '-i',
+    `color=c=${color}:s=160x90:r=25:d=1`, '-c:v', 'libx264', '-pix_fmt', 'yuv420p', file], { timeout: 30000 });
+  sourceBytes.set(file, await readFile(file));
+}
+const server = await createServer({ configFile: false, cacheDir: join(directory, 'vite-cache'),
+  optimizeDeps: { noDiscovery: true, include: [] }, plugins: [requestShapeGatePlugin(), manturProjectMediaPlugin()],
+  server: { host: '127.0.0.1', port: 0 } });
+await new Promise<void>(resolve => server.httpServer!.listen(0, '127.0.0.1', resolve));
+const address = server.httpServer!.address();
+assert(address && typeof address !== 'string');
+const origin = `http://127.0.0.1:${address.port}`;
+const nativeFetch = globalThis.fetch;
+const previousDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+const previousAnimationFrame = Object.getOwnPropertyDescriptor(globalThis, 'requestAnimationFrame');
+Object.defineProperty(globalThis, 'requestAnimationFrame', { configurable: true, value: (callback: FrameRequestCallback) => {
+  queueMicrotask(() => callback(performance.now()));
+  return 0;
+} });
+Object.defineProperty(globalThis, 'document', { configurable: true, value: {
+  querySelector: () => ({ getAttribute: () => 'enabled' }),
+} });
+let importRequests = 0;
+let holdImport: (() => Promise<void>) | undefined;
+globalThis.fetch = (input, init) => {
+  if (input !== '/api/mantur/project-media') return nativeFetch(input, init);
+  importRequests++;
+  const request = () => nativeFetch(new URL(input, origin), { ...init,
+    headers: { ...init?.headers, Origin: origin, 'Sec-Fetch-Site': 'same-origin' } });
+  return holdImport ? holdImport().then(request) : request();
+};
+const runtimes: InstanceType<typeof ExternalBridgeRuntime>[] = [];
+try {
+  for (const approvalMode of ['auto', 'manual'] as const) {
+    const projectId = `import-${approvalMode}-${randomUUID()}`;
+    const live = makeDraft(docFromTimeline({ ...INITIAL, items: [] }));
+    const context: AgentContext = { commands: live.commands, getDoc: live.getDoc, getState: live.getState,
+      getCreativeMode: () => null, getProjectId: () => projectId, templates: [], audio: [] };
+    let saved: StoredExternalProposal | null = null;
+    const runtime = new ExternalBridgeRuntime(projectId, `editor-${projectId}`, () => context, () => {}, {
+      saveProject: async () => ({ projectId, revision: 1, epoch: 1, status: 'saved', saved: true, indexUpdated: true }),
+      saveAutomaticVersion: async () => null,
+      saveExternalProposal: async (_id, proposal) => { saved = proposal; },
+    });
+    runtimes.push(runtime);
+    const binding = runtime.binding();
+    const begun = await runtime.execute('begin_edit_session', { approvalMode }, binding) as { editSessionId: string };
+    for (const [tool, path, duplicates] of [
+      ['import_asset', 'shots/A.mp4', 0], ['import_asset', 'shots/B.mp4', 0],
+      ['import_asset', 'shots/A.mp4', 1], ['import_folder', 'shots', 2],
+    ] as const) {
+      const args = { editSessionId: begun.editSessionId, path };
+      if (approvalMode === 'manual') {
+        const before = importRequests;
+        const pending = await runtime.execute(tool, args, binding) as { needs_confirmation: boolean; note: string };
+        assert.equal(pending.needs_confirmation, true);
+        assert.equal(pending.note, '确认后读取本地素材并加入当前编辑草稿，审阅草稿时统一应用。请在漫途Cut中确认后重试同一次调用。');
+        assert.equal(importRequests, before, 'manual import cannot read the file before one-shot approval');
+        const guard = runtime.pendingGuard(); assert(guard);
+        if (path === 'shots/B.mp4') {
+          await runtime.confirmRealTool(guard.id, false);
+          await runtime.execute(tool, args, binding);
+          assert.equal(importRequests, before, 'denial cannot read the local file');
+        }
+        await runtime.confirmRealTool(runtime.pendingGuard()!.id, true);
+      }
+      const result = await runtime.execute(tool, args, binding) as { ok: boolean; duplicateCount: number };
+      assert.equal(result.ok, true);
+      assert.equal(result.duplicateCount, duplicates);
+      assert.equal(revisionOf(live.getDoc()), binding.baseRevision,
+        'an approved import must not invalidate its own editing session by writing the live project');
+    }
+    assert.equal(live.getDoc().assets.length, 0);
+    const checkpoint = saved as StoredExternalProposal | null;
+    assert.equal(checkpoint?.draftCheckpoint?.draftDoc.assets.length, 3, 'draft survives checkpoints and deduplicates imports');
+    const info = await runtime.execute('get_edit_session', { editSessionId: begun.editSessionId }, binding) as { operationCount: number };
+    assert.equal(info.operationCount, 3);
+    await runtime.execute('set_aspect_ratio', { editSessionId: begun.editSessionId, ratio: '9:16' }, binding);
+    await runtime.execute('review_edit_session', { editSessionId: begun.editSessionId, summary: 'Import three clips' }, binding);
+    if (approvalMode === 'manual') {
+      assert.equal(live.getDoc().assets.length, 0, 'manual review keeps live assets untouched until apply');
+      await runtime.apply(new Set([0, 1, 2, 3]));
+    }
+    assert.equal(live.getDoc().assets.length, 3);
+    assert.equal(live.getState().width, 1080);
+    assert.equal(live.getState().height, 1920);
+  }
+  for (const interruption of ['concurrent-edit', 'cancel'] as const) {
+    const projectId = `interrupt-${randomUUID()}`;
+    const live = makeDraft(docFromTimeline({ ...INITIAL, items: [] }));
+    const runtime = new ExternalBridgeRuntime(projectId, `editor-${projectId}`, () => ({
+      commands: live.commands, getDoc: live.getDoc, getState: live.getState,
+      getCreativeMode: () => null, getProjectId: () => projectId, templates: [], audio: [],
+    }), () => {});
+    runtimes.push(runtime);
+    const binding = runtime.binding();
+    const begun = await runtime.execute('begin_edit_session', { approvalMode: 'auto' }, binding) as { editSessionId: string };
+    let release!: () => void;
+    let entered!: () => void;
+    const reached = new Promise<void>(resolve => { entered = resolve; });
+    const blocked = new Promise<void>(resolve => { release = resolve; });
+    holdImport = () => { entered(); return blocked; };
+    const controller = new AbortController();
+    const pending = runtime.execute('import_asset', { editSessionId: begun.editSessionId, path: 'shots/A.mp4' }, binding, controller.signal);
+    const outcome = Promise.allSettled([pending]);
+    let timeout: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([reached, new Promise<never>((_resolve, reject) => {
+        timeout = setTimeout(() => reject(new Error('Import did not reach the HTTP barrier within 10 seconds')), 10000);
+      })]);
+      if (interruption === 'concurrent-edit') live.commands.setAspect(720, 1280, 'contain');
+      else controller.abort();
+      release();
+      await assert.rejects(pending, interruption === 'concurrent-edit' ? /stale/ : /cancel/i);
+    } finally {
+      clearTimeout(timeout);
+      controller.abort();
+      release();
+      holdImport = undefined;
+      await outcome;
+    }
+    assert.equal(live.getDoc().assets.length, 0, 'interrupted imports never publish candidate assets');
+    assert.equal(live.getState().width, interruption === 'concurrent-edit' ? 720 : 1920);
+  }
+  for (const [file, bytes] of sourceBytes) assert.deepEqual(await readFile(file), bytes);
+  console.log('PASS: real HTTP imports retain session revision; approval/denial, deduplication, draft edits, review/apply, concurrent-edit rejection, cancellation and original files verified.');
+} finally {
+  await Promise.all(runtimes.map(runtime => runtime.disconnect()));
+  globalThis.fetch = nativeFetch;
+  if (previousDocument) Object.defineProperty(globalThis, 'document', previousDocument);
+  else Reflect.deleteProperty(globalThis, 'document');
+  if (previousAnimationFrame) Object.defineProperty(globalThis, 'requestAnimationFrame', previousAnimationFrame);
+  else Reflect.deleteProperty(globalThis, 'requestAnimationFrame');
+  await server.close();
+  for (const [key, value] of Object.entries(previousEnv)) {
+    if (value === undefined) delete process.env[key]; else process.env[key] = value;
+  }
+  await rm(directory, { recursive: true, force: true });
+}
diff --git a/server/plugins/mantur-project-media.ts b/server/plugins/mantur-project-media.ts
new file mode 100644
index 0000000..095b645
--- /dev/null
+++ b/server/plugins/mantur-project-media.ts
@@ -0,0 +1,113 @@
+import { readdir, realpath, stat } from 'node:fs/promises';
+import { realpathSync } from 'node:fs';
+import { basename, isAbsolute, relative, resolve, sep } from 'node:path';
+import type { Plugin } from 'vite';
+import { editorCredentialAuthorized } from '../editor-auth.ts';
+import { readBridgeJson, sendBridgeJson } from './external-agent-bridge-routes.ts';
+import { canonicalCurrentUploadDirectory, directoryMediaKind, importDirectoryCandidate, isPathInside } from '../../desktop/directory-watch-import.ts';
+import { scanImportDirectory } from '../../desktop/directory-watch.ts';
+import { isDirectoryImportProjectId, normalizeDirectoryImportHashes, type AgentPathImportRequest, type AgentPathImportResult } from '../../shared/directory-import.ts';
+import type { ProjectMediaListing } from '../../shared/mantur-project-media.ts';
+
+const PAGE_SIZE = 100;
+const MAX_IMPORT_PATHS = 100;
+
+function excluded(root: string, path: string): boolean {
+  const parts = relative(root, path).split(sep);
+  return parts[0] === '剪辑' || parts.some(part => part.startsWith('.') || part === 'node_modules');
+}
+
+/** Resolve every request against the Host-supplied project, including symlink targets. */
+export async function projectMediaPath(root: string, path: string): Promise<string> {
+  const requested = resolve(root, path);
+  if (!isPathInside(root, requested) || excluded(root, requested)) throw new Error('Path is outside the current project media directories');
+  const canonical = await realpath(requested);
+  if (!isPathInside(root, canonical) || excluded(root, canonical)) throw new Error('Path is outside the current project media directories');
+  return canonical;
+}
+
+async function mediaEntries(root: string, directory: string) {
+  return (await readdir(directory, { withFileTypes: true }))
+    .filter(entry => !entry.isSymbolicLink() && !excluded(root, resolve(directory, entry.name))
+      && (entry.isDirectory() || (entry.isFile() && directoryMediaKind(entry.name))))
+    .sort((a, b) => Number(b.isDirectory()) - Number(a.isDirectory()) || a.name.localeCompare(b.name));
+}
+
+export async function listProjectMedia(root: string, path: string, offset: number): Promise<ProjectMediaListing> {
+  const directory = await projectMediaPath(root, path);
+  const entries = await mediaEntries(root, directory);
+  return {
+    root, directory: relative(root, directory),
+    entries: entries.slice(offset, offset + PAGE_SIZE).map(entry => ({
+      path: relative(root, resolve(directory, entry.name)), name: entry.name,
+      kind: entry.isDirectory() ? 'directory' : directoryMediaKind(entry.name)!,
+    })),
+    nextOffset: offset + PAGE_SIZE < entries.length ? offset + PAGE_SIZE : null,
+  };
+}
+
+/** UI and Agent imports publish the same reference-backed media descriptors. */
+export async function importProjectMedia(root: string, request: AgentPathImportRequest): Promise<AgentPathImportResult> {
+  const result: { imported: AgentPathImportResult['imported'][number][]; errors: AgentPathImportResult['errors'][number][]; unsupportedFiles: string[]; duplicateCount: number } = {
+    imported: [], errors: [], unsupportedFiles: [], duplicateCount: 0,
+  };
+  const destination = await canonicalCurrentUploadDirectory();
+  const hashes = new Set(request.knownHashes);
+  const seen = new Set<string>();
+  for (const requested of request.paths) {
+    try {
+      const path = await projectMediaPath(root, requested);
+      const info = await stat(path);
+      const candidates = info.isDirectory()
+        ? await scanImportDirectory(path, { readdir: directory => mediaEntries(root, directory) }, () => false, error => { throw error; })
+        : [{ path, name: basename(path) }];
+      for (const candidate of candidates) {
+        const sourcePath = await projectMediaPath(root, candidate.path);
+        if (seen.has(sourcePath)) continue;
+        seen.add(sourcePath);
+        let failure: unknown;
+        const imported = await importDirectoryCandidate({
+          sourcePath, root, name: candidate.name, pinnedUploadDirectory: destination,
+          knownHashes: hashes, cancelled: () => false, signal: new AbortController().signal,
+          reportError: error => { failure = error; },
+        });
+        if (imported.status === 'imported') {
+          result.imported.push(imported.prepared.file);
+          if (imported.prepared.file.contentHash) hashes.add(imported.prepared.file.contentHash);
+        } else if (imported.status === 'duplicate' || imported.status === 'unchanged') result.duplicateCount++;
+        else if (imported.status === 'unsupported') result.unsupportedFiles.push(candidate.name);
+        else result.errors.push({ path: candidate.path, error: failure instanceof Error ? failure.message : 'Import could not finish; refresh and retry' });
+      }
+    } catch (error) { result.errors.push({ path: requested, error: error instanceof Error ? error.message : String(error) }); }
+  }
+  return result;
+}
+
+export function manturProjectMediaPlugin(): Plugin {
+  const configured = process.env.MANTUR_CUT_PROJECT_DIR;
+  if (configured && !isAbsolute(configured)) throw new Error('Mantur project directory must be absolute');
+  const root = configured ? realpathSync(configured) : null;
+  return {
+    name: 'mantur-project-media',
+    transformIndexHtml: () => root ? [{ tag: 'meta', attrs: { name: 'mantur-project-media', content: 'enabled' } }] : [],
+    configureServer(server) {
+      server.middlewares.use('/api/mantur/project-media', async (req, res) => {
+        if (!root) { sendBridgeJson(res, 404, { error: 'Project media is not enabled' }); return; }
+        if (req.method !== 'POST') { sendBridgeJson(res, 405, { error: 'POST required' }); return; }
+        if (!editorCredentialAuthorized(req, true)) { sendBridgeJson(res, 403, { error: 'Invalid editor origin' }); return; }
+        try {
+          const body = await readBridgeJson(req);
+          if (body.action === 'list' && typeof body.path === 'string' && Number.isSafeInteger(body.offset) && Number(body.offset) >= 0) {
+            sendBridgeJson(res, 200, await listProjectMedia(await root, body.path, Number(body.offset)));
+          } else if (body.action === 'import') {
+            const hashes = normalizeDirectoryImportHashes(body.knownHashes);
+            if (!Array.isArray(body.paths) || !body.paths.length || body.paths.length > MAX_IMPORT_PATHS
+              || !body.paths.every(path => typeof path === 'string' && path.length > 0 && path.length <= 4096)
+              || !hashes || !isDirectoryImportProjectId(body.projectId)) throw new Error('Invalid project media import request');
+            sendBridgeJson(res, 200, await importProjectMedia(await root, { paths: body.paths, projectId: body.projectId, knownHashes: hashes }));
+          } else throw new Error('Invalid project media request');
+        } catch (error) { sendBridgeJson(res, 400, { error: error instanceof Error ? error.message : String(error) }); }
+      });
+    },
+  };
+}
