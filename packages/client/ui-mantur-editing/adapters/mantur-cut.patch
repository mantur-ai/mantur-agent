+      const offsets = [];
+      if (kind === 'none' || kind === 'silence' || kind === 'zero') {
+        assert(samples.every((value) => value === 0), `${name}: silent baseline changed`);
+      } else {
+        const start = (range?.[0] ?? 0) / fps;
+        const end = start + frameCount / fps;
+        const pulses = kind === 'mix' ? [...times, 0.8, 1.3] : times;
