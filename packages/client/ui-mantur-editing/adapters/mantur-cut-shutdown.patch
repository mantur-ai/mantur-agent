index 0000000..71bcf61
--- /dev/null
+++ b/server/external-agent/broker-shutdown.verify.ts
@@ -0,0 +1,104 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtemp, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'unregister-failure', 'failed-flush', 'no-browser']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('broker shutdown: 4 isolated native-channel and durable unregister cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-broker-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  try {
+    const broker = await import('./broker.ts');
+    if (scenario === 'no-browser') {
+      await broker.stopEditorCallsForShutdown();
+      await assert.rejects(broker.requestEditorShutdown('freeze', 1000), /No browser editor/);
+    } else {
+      const store = await import('../plugins/project-store.ts');
+      const { INITIAL } = await import('../../src/editor/initial.ts');
+      const { docFromTimeline } = await import('../../src/persist/projectStore.ts');
+      const { revisionOf } = await import('../../src/agent/external-edit-session.ts');
+      const { claimBrowserProjectOwnership, projectEditOwnershipKey } = await import('./project-edit-ownership.ts');
+      const projectId = 'shutdown-project';
+      const editorId = 'shutdown-editor';
+      const doc = docFromTimeline(INITIAL);
+      await store.setStoredEntry(`project:${projectId}`, doc);
+      const revision = revisionOf(doc);
+      const ownership = await claimBrowserProjectOwnership(projectId, editorId, revision);
+      assert.equal(ownership.status, 'claimed');
+      if (ownership.status !== 'claimed') throw new Error('Test ownership setup failed');
+      const capability = broker.registerEditor(projectId, editorId, revision, [], ownership.claim);
+      const binding = broker.editorBinding(projectId)!;
+      const poll = () => broker.nextEditorCall(projectId, editorId, revision, AbortSignal.timeout(1000), capability);
+      const accepted = broker.invokeEditorTool('native-owner', binding, 'read_timeline', {});
+      const acceptedCall = await poll();
+      assert(acceptedCall);
+      const cutoff = broker.stopEditorCallsForShutdown();
+      assert.strictEqual(cutoff, broker.stopEditorCallsForShutdown());
+      let drained = false;
+      void cutoff.then(() => { drained = true; });
+      await assert.rejects(broker.invokeEditorTool('late-owner', binding, 'read_timeline', {}), /shutting down/);
+      await tick(); assert.equal(drained, false);
+      assert.equal(broker.settleEditorCall(acceptedCall.id, 'applied', { fps: 30 }, capability), true);
+      await accepted; await cutoff;
+      const freezing = broker.requestEditorShutdown('freeze', 1000);
+      const freezeCall = await poll();
+      assert.equal(freezeCall?.name, 'mantur_shutdown');
+      assert.equal(broker.settleEditorCall(freezeCall!.id, 'applied', { phase: 'freeze' }, capability), true);
+      await freezing;
+      const flushing = broker.requestEditorShutdown('flush', 1000);
+      const observed = flushing.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+      const flushCall = await poll();
+      assert.equal(flushCall?.arguments.phase, 'flush');
+      if (scenario === 'failed-flush') {
+        assert.equal(broker.settleEditorCall(flushCall!.id, 'failed', 'browser checkpoint failed', capability), true);
+        const result = await observed;
+        assert.equal(result.ok, false);
+        if (!result.ok) assert.match(String(result.error), /browser checkpoint failed/);
+        assert.equal(broker.isProjectConnected(projectId), true, 'failed browser retains its registration');
+      } else {
+        const entered = Promise.withResolvers<void>();
+        const release = Promise.withResolvers<void>();
+        const heldWrite = store.withSerializedProjectStore(async () => { entered.resolve(); await release.promise; });
+        await entered.promise;
+        assert.equal(broker.settleEditorCall(flushCall!.id, 'applied', { phase: 'flush' }, capability), true);
+        let confirmed = false;
+        void observed.then(() => { confirmed = true; });
+        const unregister = broker.unregisterEditor(projectId, editorId, capability);
+        const unregisterResult = unregister.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+        await tick();
+        assert.equal(broker.isProjectConnected(projectId), false);
+        assert.equal(confirmed, false, 'removing registration is not durable lease release');
+        if (scenario === 'unregister-failure') {
+          await rename(join(root, 'project-store-v1'), join(root, 'before-failure'));
+          await writeFile(join(root, 'project-store-v1'), 'not a directory');
+        }
+        release.resolve(); await heldWrite;
+        const result = await observed;
+        const released = await unregisterResult;
+        assert.equal(result.ok, scenario === 'accepted');
+        assert.equal(released.ok, scenario === 'accepted');
+        if (scenario === 'accepted') {
+          await broker.stopEditorRegistrationsForShutdown();
+          await store.stopProjectStoreForShutdown();
+          const lease = JSON.parse(await readFile(join(root, 'project-store-v1', `${encodeURIComponent(projectEditOwnershipKey(projectId))}.json`), 'utf8'));
+          assert.equal(lease.leaseExpiresAt, 0);
+        } else {
+          await assert.rejects(broker.stopEditorRegistrationsForShutdown(), /failed; shutdown is unconfirmed/);
+        }
+      }
+    }
+  } finally { await rm(root, { recursive: true, force: true }); }
+}
