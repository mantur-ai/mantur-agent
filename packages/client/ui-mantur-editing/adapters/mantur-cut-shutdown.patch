index 0000000..774bce6
--- /dev/null
+++ b/server/external-agent/broker-settlement.verify.ts
@@ -0,0 +1,290 @@
+// Runnable check: node --import tsx server/external-agent/broker-settlement.verify.ts
+import assert from 'node:assert/strict';
+import { mkdtemp, rename, rm, writeFile } from 'node:fs/promises';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Readable } from 'node:stream';
+import { mock } from 'node:test';
+
+const root = await mkdtemp(join(tmpdir(), 'mantur-broker-settlement-'));
+process.env.OPENCHATCUT_DATA_DIR = root;
+process.env.OPENCHATCUT_SQLITE_STORE = '0';
+process.env.OPENCHATCUT_EDITOR_URL = 'http://127.0.0.1:5199';
+process.env.OPENCHATCUT_MCP_TOKEN = 'isolated-settlement-fixture';
+const broker = await import('./broker.ts');
+const store = await import('../plugins/project-store.ts');
+const ownership = await import('./project-edit-ownership.ts');
+const { EditorConnectionRegistry } = await import('./broker-registry.ts');
+const { handleExternalAgentBridge } = await import('../plugins/external-agent.ts');
+const { INITIAL } = await import('../../src/editor/initial.ts');
+const { docFromTimeline } = await import('../../src/persist/projectStore.ts');
+const { revisionOf } = await import('../../src/agent/external-edit-session.ts');
+const originalTouch = EditorConnectionRegistry.prototype.touch;
+let touchEntered: PromiseWithResolvers<void> | undefined;
+let touchCount = 0;
+const heldStores = new Set<() => Promise<void>>();
+const resultRequests = new Set<Promise<void>>();
+mock.method(EditorConnectionRegistry.prototype, 'touch', function (
+  this: InstanceType<typeof EditorConnectionRegistry>,
+  ...args: Parameters<typeof originalTouch>
+) {
+  touchCount += 1;
+  touchEntered?.resolve();
+  return originalTouch.apply(this, args);
+});
+
+function observe<T>(promise: Promise<T>) {
+  let state = 'pending';
+  const result = promise.then(
+    value => { state = 'applied'; return { ok: true as const, value }; },
+    (error: unknown) => { state = 'failed'; return { ok: false as const, error }; },
+  );
+  return { result, state: () => state };
+}
+
+function postResult(id: string, capability: string, baseRevision: string) {
+  const request = Object.assign(Readable.from([JSON.stringify({
+    id, outcome: 'applied', value: { status: 'applied' }, baseRevision,
+  })]), {
+    method: 'POST', url: '/result',
+    headers: {
+      host: '127.0.0.1:5199', origin: 'http://127.0.0.1:5199',
+      'content-type': 'application/json',
+      'x-openchatcut-editor-registration': capability,
+    },
+    socket: { remoteAddress: '127.0.0.1' },
+  }) as IncomingMessage;
+  let body: string | undefined;
+  const response = {
+    statusCode: 0,
+    setHeader: () => undefined,
+    end: (value: string) => { body = value; },
+  } as unknown as ServerResponse;
+  const done = handleExternalAgentBridge(request, response).catch((error: unknown) => {
+    response.statusCode = 500;
+    response.end(error instanceof Error ? error.message : String(error));
+  }).finally(() => { resultRequests.delete(done); });
+  resultRequests.add(done);
+  return { done, response, body: () => body };
+}
+
+let serial = 0;
+async function fixture(owned = true, timeoutMs = 30_000) {
+  broker.resetExternalAgentBrokerForTest();
+  const projectId = `settlement-project-${++serial}`;
+  const editorId = 'settlement-editor';
+  const before = docFromTimeline(INITIAL);
+  const after = docFromTimeline({ ...INITIAL, width: 1080, height: 1920 });
+  const oldRevision = revisionOf(before);
+  const newRevision = revisionOf(after);
+  assert.notEqual(oldRevision, newRevision);
+  let claim: import('./project-edit-ownership.ts').ProjectEditOwnershipClaim | undefined;
+  if (owned) {
+    await store.setStoredEntry(`project:${projectId}`, before);
+    const claimed = await ownership.claimBrowserProjectOwnership(projectId, editorId, oldRevision);
+    assert.equal(claimed.status, 'claimed');
+    if (claimed.status !== 'claimed') throw new Error('Fixture ownership was not acquired');
+    claim = claimed.claim;
+  }
+  const capability = broker.registerEditor(projectId, editorId, oldRevision, [], claim);
+  const binding = broker.editorBinding(projectId)!;
+  const result = observe(broker.invokeEditorTool('owner', binding, 'review_edit_session', {}, timeoutMs));
+  const call = await broker.nextEditorCall(projectId, editorId, oldRevision, new AbortController().signal, capability);
+  assert(call);
+  if (claim) {
+    await store.withSerializedProjectStore(async locked => {
+      await locked.writeEntryExact(`project:${projectId}`, after);
+      await locked.writeEntryExact(
+        ownership.projectEditOwnershipKey(projectId),
+        ownership.renewedProjectEditOwnership(claim!, newRevision),
+      );
+    });
+  }
+  return { projectId, editorId, oldRevision, newRevision, capability, binding, claim, result, call };
+}
+
+async function holdStore() {
+  let beforeRelease: ((locked: import('../plugins/project-store.ts').LockedProjectStore) => Promise<void>) | undefined;
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const held = store.withSerializedProjectStore(async locked => {
+    entered.resolve();
+    await release.promise;
+    if (beforeRelease) await beforeRelease(locked);
+  });
+  await entered.promise;
+  const releaseStore = async (write?: typeof beforeRelease) => {
+    beforeRelease = write;
+    release.resolve();
+    try { await held; } finally { heldStores.delete(releaseStore); }
+  };
+  heldStores.add(releaseStore);
+  return { release: releaseStore };
+}
+
+async function pendingSync(f: Awaited<ReturnType<typeof fixture>>, reportedRevision = f.newRevision) {
+  const barrier = await holdStore();
+  touchEntered = Promise.withResolvers<void>();
+  const request = postResult(f.call.id, f.capability, reportedRevision);
+  await touchEntered.promise;
+  touchEntered = undefined;
+  await Promise.resolve();
+  assert.equal(f.result.state(), 'pending', 'MCP must remain pending while revision synchronization is blocked');
+  assert.equal(request.body(), undefined, 'HTTP success must wait for revision synchronization');
+  return { request, barrier };
+}
+
+function assertFailure(result: { ok: true; value: unknown } | { ok: false; error: unknown }, outcome: string) {
+  assert.equal(result.ok, false);
+  if (!result.ok) {
+    assert(result.error instanceof broker.ExternalEditorCallError);
+    assert.equal(result.error.outcome, outcome);
+  }
+}
+
+let testFailed = false;
+try {
+  // The continuation starts from MCP success, before the result HTTP handler returns.
+  {
+    const f = await fixture();
+    const { request, barrier } = await pendingSync(f, 'browser-revision-is-not-authoritative');
+    const duplicate = postResult(f.call.id, f.capability, f.newRevision);
+    const touches = touchCount;
+    await duplicate.done;
+    assert.equal(duplicate.response.statusCode, 404);
+    assert.equal(touchCount, touches, 'duplicate completion cannot start another renewal');
+    const next = f.result.result.then(result => {
+      assert.equal(result.ok, true);
+      assert.equal(broker.editorBinding(f.projectId)?.baseRevision, f.newRevision);
+      return observe(broker.invokeEditorTool('owner', broker.editorBinding(f.projectId)!, 'begin_edit_session', {}));
+    });
+    await barrier.release();
+    const nextResult = await next;
+    const nextCall = await broker.nextEditorCall(
+      f.projectId, f.editorId, f.newRevision, new AbortController().signal, f.capability,
+    );
+    assert.equal(nextCall?.binding.baseRevision, f.newRevision);
+    broker.settleEditorCall(nextCall!.id, 'applied', { editSessionId: 'second-round' }, f.capability);
+    assert.equal((await nextResult.result).ok, true);
+    await request.done;
+    assert.equal(request.response.statusCode, 200);
+  }
+
+  // No-ownership revision changes exempt only the call whose result advances it.
+  {
+    const f = await fixture(false);
+    const sibling = observe(broker.invokeEditorTool('other-owner', f.binding, 'read_timeline', {}));
+    const request = postResult(f.call.id, f.capability, f.newRevision);
+    await request.done;
+    assert.equal(request.response.statusCode, 200);
+    assert.equal((await f.result.result).ok, true);
+    assertFailure(await sibling.result, 'stale');
+    assert.equal(broker.editorBinding(f.projectId)?.baseRevision, f.newRevision);
+  }
+
+  // A capability is checked before touching the registry or accepting any result.
+  {
+    const f = await fixture(false);
+    const touches = touchCount;
+    const expiredTime = Date.now() + 60_000;
+    const clock = mock.method(Date, 'now', () => expiredTime);
+    const invalid = postResult(f.call.id, 'x'.repeat(43), f.newRevision);
+    try { await invalid.done; } finally { clock.mock.restore(); }
+    assert.equal(invalid.response.statusCode, 404);
+    assert.equal(touchCount, touches);
+    assert.equal(f.result.state(), 'pending');
+    assert.equal(broker.editorBinding(f.projectId)?.baseRevision, f.oldRevision);
+    const queued = observe(broker.invokeEditorTool('queued-owner', f.binding, 'read_timeline', {}));
+    const queuedId = broker.pendingEditorCallsForTest('queued-owner')[0]!.id;
+    const undelivered = postResult(queuedId, f.capability, f.newRevision);
+    await undelivered.done;
+    assert.equal(undelivered.response.statusCode, 404);
+    assert.equal(touchCount, touches);
+    broker.cancelEditorCallsForOwner('queued-owner');
+    await queued.result;
+    await postResult(f.call.id, f.capability, f.newRevision).done;
+    assert.equal((await f.result.result).ok, true);
+  }
+
+  for (const stop of ['cancel', 'timeout'] as const) {
+    const f = await fixture();
+    const { request, barrier } = await pendingSync(f);
+    const expiredTime = Date.now() + 60_000;
+    const clock = stop === 'timeout' ? mock.method(Date, 'now', () => expiredTime) : undefined;
+    if (stop === 'cancel') broker.cancelEditorCallsForOwner('owner');
+    try {
+      await barrier.release();
+      await request.done;
+    } finally { clock?.mock.restore(); }
+    assertFailure(await f.result.result, 'cancelled');
+    assert.equal(request.response.statusCode, 404);
+    assert.equal(broker.editorBinding(f.projectId)?.baseRevision, f.oldRevision);
+    assert.equal(broker.pendingEditorCallsForTest().length, 0);
+    const late = postResult(f.call.id, f.capability, f.newRevision);
+    await late.done;
+    assert.equal(late.response.statusCode, 404);
+  }
+
+
+  for (const replacement of ['same-binding', 'new-capability', 'new-epoch'] as const) {
+    const f = await fixture();
+    const { request, barrier } = await pendingSync(f);
+    const claim = replacement === 'new-epoch' ? { ...f.claim!, epoch: f.claim!.epoch + 1 } : f.claim!;
+    const capability = broker.registerEditor(
+      f.projectId, f.editorId, f.oldRevision, [], claim,
+      replacement === 'new-capability' ? null : f.capability,
+    );
+    await barrier.release(replacement === 'new-epoch' ? async locked => {
+      await locked.writeEntryExact(
+        ownership.projectEditOwnershipKey(f.projectId),
+        ownership.renewedProjectEditOwnership(claim, f.newRevision),
+      );
+    } : undefined);
+    await request.done;
+    assertFailure(await f.result.result, 'stale');
+    assert.equal(request.response.statusCode, 404);
+    assert.deepEqual(broker.editorBinding(f.projectId), { ...f.binding, ownershipEpoch: claim.epoch });
+    assert.equal(broker.editorRegistrationMatches(f.projectId, f.editorId, capability), true);
+    assert.equal(broker.pendingEditorCallsForTest().length, 0);
+  }
+
+  // A real project-store I/O failure cannot be hidden behind an applied result.
+  {
+    const f = await fixture();
+    const { request, barrier } = await pendingSync(f);
+    await rename(join(root, 'project-store-v1'), join(root, 'before-io-failure'));
+    await writeFile(join(root, 'project-store-v1'), 'not a directory');
+    await barrier.release();
+    await request.done;
+    assertFailure(await f.result.result, 'failed');
+    assert.equal(request.response.statusCode, 500);
+    assert.match(request.body()!, /ENOTDIR/);
+    assert.equal(broker.pendingEditorCallsForTest().length, 0);
+    assert.equal(broker.editorBinding(f.projectId)?.baseRevision, f.oldRevision);
+    await assert.rejects(broker.stopEditorCallsForShutdown(), /failed; shutdown is unconfirmed/);
+    await assert.rejects(broker.stopEditorRegistrationsForShutdown(), /failed; shutdown is unconfirmed/);
+  }
+
+  console.log('broker settlement: 9 deterministic route/broker scenarios passed, including real ownership renewal and I/O failure');
+} catch (error) {
+  testFailed = true;
