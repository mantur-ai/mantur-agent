new file mode 100644
index 0000000..6b36880
--- /dev/null
+++ b/src/editor/mantur-shutdown.ts
@@ -0,0 +1,55 @@
+import { ShutdownWork } from '../../shared/shutdown-work';
+
+const background = new ShutdownWork('Browser editor background work');
+const autosaves = new ShutdownWork('Browser autosave completions');
+const saveOwners = new Map<string, () => Promise<boolean>>();
+let inputFrozen = false;
+const pointers = new Set<number>();
+
+if (typeof window !== 'undefined') {
+  // Install before React effect-based shortcut handlers. Background tasks retain their signals.
+  const blockInput = (event: Event) => {
+    if (!inputFrozen) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+  };
+  for (const event of ['keydown', 'pointerdown', 'drop', 'paste']) window.addEventListener(event, blockInput, true);
+  window.addEventListener('pointerdown', (event) => pointers.add(event.pointerId), true);
+  for (const event of ['pointerup', 'pointercancel'] as const) {
+    window.addEventListener(event, (event) => pointers.delete(event.pointerId), true);
+  }
+}
+
+/** Do not interrupt an in-progress timeline gesture to claim a saved document. */
+export function freezeEditorInputForShutdown(): void {
+  if (pointers.size) throw new Error('An editor pointer gesture is still in progress');
+  inputFrozen = true;
+  document.body.inert = true;
+}
+
+/** Register the mounted editor's pending debounce, not just its persistence queue. */
+export function registerEditorSaveOwner(projectId: string, flush: () => Promise<boolean>): () => void {
+  if (saveOwners.has(projectId)) throw new Error(`Multiple editor save owners for ${projectId}`);
+  saveOwners.set(projectId, flush);
+  return () => { if (saveOwners.get(projectId) === flush) saveOwners.delete(projectId); };
+}
+
+/** Original background promise, including result ingestion and its later document mutation. */
+export function trackEditorBackground<T>(work: Promise<T>): Promise<T> { return background.track(work); }
+
+/** Keep failure evidence when an existing UI operation converts rejection into a visible status. */
+export function recordEditorBackgroundFailure(error: unknown): void { background.recordFailure(error); }
+
+/** Original autosave promise, including the durable generation-result acknowledgement. */
+export function trackEditorAutosave<T>(work: Promise<T>): Promise<T> { return autosaves.track(work); }
+
+/** Call after backend jobs settle and browser input admission is frozen. */
+export function stopEditorBackgroundForShutdown(): Promise<void> { return background.stop(); }
+
+/** Flush the mounted editor's newest pending document before sealing its acknowledgements. */
+export async function flushEditorForShutdown(projectId: string): Promise<void> {
+  const flush = saveOwners.get(projectId);
+  if (!flush) throw new Error(`Editor ${projectId} has no mounted authoritative save owner`);
+  if (!await flush()) throw new Error(`Editor ${projectId} has unsaved project changes`);
+  await autosaves.stop();
+}
