diff --git a/desktop/mantur-export.verify.ts b/desktop/mantur-export.verify.ts
new file mode 100644
index 0000000..fed4548
--- /dev/null
+++ b/desktop/mantur-export.verify.ts
@@ -0,0 +1,45 @@
+/** Packaged HTML carries a live default grant; only that editor origin may write it. */
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+const root = await mkdtemp(join(tmpdir(), 'mantur-embedded-export-'));
+const directory = join(root, 'exports & "chosen"');
+const dist = join(root, 'dist');
+await mkdir(directory);
+await mkdir(dist);
+await writeFile(join(dist, 'index.html'), '<html><head></head><body>editor</body></html>');
+process.env.OPENCHATCUT_DATA_DIR = root;
+process.env.OPENCHATCUT_SQLITE_STORE = '0';
+process.env.MANTUR_CUT_EXPORT_DIR = directory;
+process.env.OPENCHATCUT_MCP_TOKEN = 'test-only-export-token';
+process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS = '3000';
+const { startEmbeddedServer } = await import('./embedded-server.ts');
+const embedded = await startEmbeddedServer(dist, { port: 0, parentOrigin: 'http://127.0.0.1:40201' });
+try {
+  const response = await fetch(embedded.origin);
+  assert.equal(response.status, 200);
+  const html = await response.text();
+  const meta = html.match(/<meta name="mantur-cut-export" content="([^"]+)">/);
+  assert(meta, 'packaged HTML must provide its export directory grant');
+  const grant = JSON.parse(meta[1].replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&amp;/g, '&')) as { grantId: string; label: string };
+  assert.equal(grant.label, 'exports & "chosen"');
+  assert.match(grant.grantId, /^[A-Za-z0-9_-]{32,128}$/);
+  const url = `${embedded.origin}/api/export-destinations/${grant.grantId}/clip.mp4`;
+  const denied = await fetch(url, { method: 'PUT', headers: { Origin: 'https://untrusted.example', 'Sec-Fetch-Site': 'cross-site' }, body: 'bad' });
+  assert.equal(denied.status, 403);
+  const saved = await fetch(url, { method: 'PUT', headers: { Origin: embedded.origin, 'Sec-Fetch-Site': 'same-origin' }, body: 'export bytes' });
+  assert.equal(saved.status, 204);
+  assert.equal(await readFile(join(directory, 'clip.mp4'), 'utf8'), 'export bytes');
+  const invalid = await fetch(`${embedded.origin}/api/export-destinations/${grant.grantId}/..%2Fescape.mp4`, {
+    method: 'PUT', headers: { Origin: embedded.origin, 'Sec-Fetch-Site': 'same-origin' }, body: 'bad',
+  });
+  assert.equal(invalid.status, 400);
+  console.log('packaged export HTML, origin denial and default directory write passed');
+} finally {
+  const { stopEditorMaintenanceForShutdown } = await import('../server/shutdown-runtime.ts');
+  await stopEditorMaintenanceForShutdown();
+  embedded.server.closeAllConnections();
+  await new Promise<void>((resolve, reject) => embedded.server.close(error => error ? reject(error) : resolve()));
+  await rm(root, { recursive: true, force: true });
+}
