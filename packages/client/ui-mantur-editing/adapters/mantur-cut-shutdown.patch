@@ -0,0 +1,53 @@
+/** Actual accepted work and failures retained until its owning process closes. */
+export class ShutdownWork {
+  private readonly pending = new Set<Promise<unknown>>();
+  private readonly failures: unknown[] = [];
+  private accepting = true;
+  private settled = false;
+  private stopping: Promise<void> | undefined;
+  private readonly name: string;
+
+  constructor(name: string) { this.name = name; }
+
+  /** Reject new submissions synchronously; already accepted work keeps its signals. */
+  freeze(): void { this.accepting = false; }
+
+  /** Register before invoking the producer, including its startup awaits. */
+  admit<T>(work: () => Promise<T>): Promise<T> {
+    if (!this.accepting) return Promise.reject(new Error(`${this.name} is shutting down`));
+    const accepted = Promise.withResolvers<T>();
+    this.track(accepted.promise);
+    try {
