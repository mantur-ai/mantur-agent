+import { fileURLToPath } from 'node:url';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'unregister-failure', 'failed-flush', 'no-browser']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('broker shutdown: 4 isolated native-channel and durable unregister cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-broker-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  try {
+    const broker = await import('./broker.ts');
+    if (scenario === 'no-browser') {
+      await broker.stopEditorCallsForShutdown();
+      await assert.rejects(broker.requestEditorShutdown('freeze', 1000), /No browser editor/);
+    } else {
+      const store = await import('../plugins/project-store.ts');
+      const { INITIAL } = await import('../../src/editor/initial.ts');
+      const { docFromTimeline } = await import('../../src/persist/projectStore.ts');
+      const { revisionOf } = await import('../../src/agent/external-edit-session.ts');
+      const { claimBrowserProjectOwnership, projectEditOwnershipKey } = await import('./project-edit-ownership.ts');
+      const projectId = 'shutdown-project';
+      const editorId = 'shutdown-editor';
+      const doc = docFromTimeline(INITIAL);
+      await store.setStoredEntry(`project:${projectId}`, doc);
+      const revision = revisionOf(doc);
+      const ownership = await claimBrowserProjectOwnership(projectId, editorId, revision);
+      assert.equal(ownership.status, 'claimed');
+      if (ownership.status !== 'claimed') throw new Error('Test ownership setup failed');
+      const capability = broker.registerEditor(projectId, editorId, revision, [], ownership.claim);
+      const binding = broker.editorBinding(projectId)!;
+      const poll = () => broker.nextEditorCall(projectId, editorId, revision, AbortSignal.timeout(1000), capability);
+      const accepted = broker.invokeEditorTool('native-owner', binding, 'read_timeline', {});
+      const acceptedCall = await poll();
+      assert(acceptedCall);
+      const cutoff = broker.stopEditorCallsForShutdown();
+      assert.strictEqual(cutoff, broker.stopEditorCallsForShutdown());
+      let drained = false;
+      void cutoff.then(() => { drained = true; });
+      await assert.rejects(broker.invokeEditorTool('late-owner', binding, 'read_timeline', {}), /shutting down/);
+      await tick(); assert.equal(drained, false);
