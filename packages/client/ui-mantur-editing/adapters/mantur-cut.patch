+  onShowPool: () => void;
+}
+
+export function ProjectMediaPanel({ projectId, fps, assets, offlineAssetIds, onIngest, onRelink, onShowPool }: Props) {
+  const t = useT();
+  const [path, setPath] = useState('');
+  const [revision, setRevision] = useState(0);
+  const [listing, setListing] = useState<ProjectMediaListing>();
+  const [selected, setSelected] = useState<string[]>([]);
+  const [target, setTarget] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const alive = useRef(false);
+  useEffect(() => { alive.current = true; return () => { alive.current = false; }; }, []);
+  useEffect(() => {
+    let active = true;
+    setListing(undefined); setSelected([]); setError('');
+    void listProjectMedia(path).then(value => { if (active) setListing(value); })
+      .catch(error => { if (active) setError(String(error.message ?? error)); });
+    return () => { active = false; };
+  }, [path, revision]);
+
+  const loadMore = async () => {
+    if (!listing || listing.nextOffset === null) return;
+    setBusy(true); setError('');
+    try {
+      const next = await listProjectMedia(path, listing.nextOffset);
+      if (alive.current) setListing({ ...next, entries: [...listing.entries, ...next.entries] });
+    } catch (error) { if (alive.current) setError(error instanceof Error ? error.message : String(error)); }
+    finally { if (alive.current) setBusy(false); }
+  };
+  const ingest = async () => {
+    setBusy(true); setError(''); setNotice('');
+    try {
+      const result = await importProjectMedia({ paths: selected, projectId,
+        knownHashes: target ? [] : assets.flatMap(asset => asset.sourceContentHash ? [asset.sourceContentHash] : []),
+      });
+      const imported = await Promise.all(result.imported.map(file => directoryFileToAsset({ ...file, importId: crypto.randomUUID() }, fps)));
+      if (!alive.current) return;
+      if (target && imported.length === 1) { onRelink?.(target, mediaAssetRelinkPatch(imported[0])); setTarget(''); }
+      else if (!target) imported.forEach(onIngest);
+      setNotice(t('已引用 {count} 个素材，跳过 {duplicates} 个重复素材', { count: imported.length, duplicates: result.duplicateCount }));
+      if (result.errors.length || result.unsupportedFiles.length) setError([
+        ...result.errors.map(item => `${item.path}: ${item.error}`), ...result.unsupportedFiles,
+      ].join('\n'));
+      setSelected([]);
+    } catch (error) { if (alive.current) setError(error instanceof Error ? error.message : String(error)); }
+    finally { if (alive.current) setBusy(false); }
+  };
+  const offline = assets.filter(asset => offlineAssetIds.has(asset.id));
+  const parent = path.split(/[\\/]/).slice(0, -1).join('/');
+  return <section className="mantur-project-media" aria-label={t('项目素材')}>
+    <div className="mantur-project-toolbar">
+      <button type="button" disabled={!path || busy} onClick={() => setPath(parent)}>{t('上一级')}</button>
+      <button type="button" disabled={busy} onClick={() => setRevision(value => value + 1)}>{t('刷新素材')}</button>
+    </div>
+    <div className="mantur-project-path" title={listing?.root}>{path || t('项目根目录')}</div>
+    <p>{t('兼容素材直接引用；转码另存，不改原片。不列出剪辑缓存及导出。')}</p>
+    {!!offline.length && onRelink && <label>{t('重新定位素材')}
+      <select aria-label={t('重新定位素材')} disabled={busy} value={target} onChange={event => { setTarget(event.target.value); setSelected([]); }}>
+        <option value="">{t('添加为新素材')}</option>
+        {offline.map(asset => <option key={asset.id} value={asset.id}>{asset.name}</option>)}
+      </select>
+    </label>}
+    {error && <p role="alert">{error}</p>}
+    {notice && <p role="status">{notice}</p>}
+    {!listing && !error && <p role="status">{t('正在读取项目素材…')}</p>}
+    <div className="mantur-project-files">
+      {listing?.entries.map(entry => entry.kind === 'directory'
+        ? <button type="button" className="mantur-project-folder" key={entry.path} disabled={busy} onClick={() => setPath(entry.path)}>▸ {entry.name}</button>
+        : <label className="mantur-project-file" key={entry.path}>
+          <input type="checkbox" disabled={busy} checked={selected.includes(entry.path)} onChange={event => setSelected(current => event.target.checked
+            ? target ? [entry.path] : [...current, entry.path] : current.filter(path => path !== entry.path))} />
+          <span title={entry.name}>{entry.name}</span>
+        </label>)}
+      {listing?.entries.length === 0 && <p>{t('此文件夹没有支持的素材')}</p>}
+      {listing?.nextOffset !== null && listing?.nextOffset !== undefined && <button type="button" disabled={busy} onClick={() => void loadMore()}>{t('加载更多素材')}</button>}
+    </div>
+    <div className="mantur-project-toolbar">
+      <button type="button" disabled={busy || !selected.length} onClick={() => void ingest()}>{busy ? t('正在引用素材…') : target ? t('重新定位素材') : t('引用所选素材')}</button>
+      <button type="button" disabled={busy} onClick={onShowPool}>{t('查看已引用素材')}</button>
+    </div>
+  </section>;
+}
