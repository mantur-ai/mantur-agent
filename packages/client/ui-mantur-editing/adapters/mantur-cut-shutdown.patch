+  fault = 'none';
+  assert.equal((await saveProject(projectId, dirty)).saved, true);
+  assert.equal((await flushProjectSaves(projectId)).ok, true);
+  assert.equal(hasProjectSaveFailure(projectId), false);
+  assert.equal(revisionOf(JSON.parse(await readFile(storedFile, 'utf8'))), revisionOf(dirty));
+  await disconnect(transport.browserProjectOwnership(projectId)!);
+  resetProjectStoreMemory();
+  const reopened = await loadProjectForEditing(projectId);
+  assert.equal(reopened.status, 'ok');
+  if (reopened.status !== 'ok') throw new Error('saved project did not reopen');
+  assert.deepEqual(reopened.doc, dirty, 'reopen after clearing client memory reads the durable document');
+
+  lease = await claim('editor-a');
+  assert.equal(transport.installBrowserProjectOwnership(lease, transport.browserProjectBase(projectId)), true);
+  await unregisterEditorBridge(projectId, lease.ownerId, lease.registrationCapability, true);
+  const competitor = await claim('editor-b');
+  assert.ok(competitor.epoch > lease.epoch);
+  const rejectedDoc = structuredClone(dirty);
+  rejectedDoc.timelines[0].width = 640;
+  const savedBytes = await readFile(storedFile, 'utf8');
+  for (let attempt = 0; attempt < 2; attempt += 1) {
+    const before = writeRequests;
+    lastWrite = undefined;
+    assert.equal((await saveProject(projectId, rejectedDoc)).saved, false, 'old owner is rejected with current revision');
+    assert.equal(writeRequests, before + 1);
+    // The fetch callback assigns this observation during the awaited save.
+    const rejectedWrite = lastWrite as ObservedWrite | undefined;
+    assert.ok(rejectedWrite, 'a real HTTP owner response was observed');
+    assert.equal(rejectedWrite.status, 200);
+    assert.equal(rejectedWrite.response.accepted, false);
+    assert.equal(rejectedWrite.response.currentRevision, revisionOf(dirty));
+    assert.equal(rejectedWrite.request.expectedRevision, rejectedWrite.response.currentRevision,
+      'owner rejection is tested with a matching current revision');
+    assert.equal(rejectedWrite.request.ownerId, lease.ownerId);
+    assert.equal(rejectedWrite.request.ownershipEpoch, lease.epoch);
+    assert.equal((await flushProjectSaves(projectId)).ok, false);
+    assert.equal(await readFile(storedFile, 'utf8'), savedBytes);
+    assert.equal(transport.browserProjectBase(projectId).revision, revisionOf(dirty));
+  }
+  await unregisterEditorBridge(projectId, competitor.ownerId, competitor.registrationCapability, true);
+  resetProjectStoreMemory();
+  Reflect.deleteProperty(globalThis, 'location');
+  assert.equal((await saveProject('standalone', base)).saved, true);
+  assert.equal((await flushProjectSaves('standalone')).ok, true);
+  const local = await loadProjectForEditing('standalone');
+  assert.equal(local.status, 'ok');
+  if (local.status === 'ok') assert.deepEqual(local.doc, base);
+  broker.resetExternalAgentBrokerForTest();
+  console.log('mantur-save-fallback-http: repeated 503/disconnect/bootstrap failure, dirty leave guard, durable retry/reopen, owner fencing and standalone local passed');
+} finally {
+  globalThis.fetch = originalFetch;
+  if (previousLocation) Object.defineProperty(globalThis, 'location', previousLocation);
+  else Reflect.deleteProperty(globalThis, 'location');
+  server.closeAllConnections();
+  if (server.listening) await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+  if (previousDataDir === undefined) delete process.env.OPENCHATCUT_DATA_DIR;
+  else process.env.OPENCHATCUT_DATA_DIR = previousDataDir;
+  await rm(root, { recursive: true, force: true });
+}
diff --git a/server/plugins/mantur-shutdown.ts b/server/plugins/mantur-shutdown.ts
new file mode 100644
index 0000000..6b0cf21
--- /dev/null
+++ b/server/plugins/mantur-shutdown.ts
@@ -0,0 +1,172 @@
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { ShutdownWork } from '../../shared/shutdown-work.ts';
+import { isIsolatedDevProfile } from '../runtime-profile.ts';
+import { Server } from 'node:http';
+import type { Connect, Plugin, ViteDevServer } from 'vite';
+import {
+  editorRequests, editorCallbacks, recordUnconfirmedEditorProducer,
+  stopEditorMaintenanceForShutdown, stopEditorMediaProcessesForShutdown,
+} from '../shutdown-runtime.ts';
+import { stopGenerationJobsForShutdown } from './generation-job-lifecycle.ts';
+import { stopProjectStoreForShutdown } from './project-store.ts';
+import {
+  requestEditorShutdown, stopEditorCallsForShutdown, stopEditorRegistrationsForShutdown,
+} from '../external-agent/broker.ts';
+import { stopMcpRetirementsForShutdown } from '../external-agent/mcp.ts';
+import { flushServerRunPersistence } from '../agent-runs/store.ts';
+import { assertRenderShutdownConfirmed } from '../../remotion/render-shutdown.mjs';
+
+declare module 'node:http' {
+  interface Server {
+    /** Actual shared editor owner, consumed by the development and packaged Host adapters. */
+    manturShutdown?: { stopForShutdown(): Promise<void>; finishTransportShutdown(): Promise<void> };
+  }
+}
+
+const OWNED_PLUGINS = new Set([
+  'openchatcut-request-shape-gate', 'openchatcut-cross-origin-isolation',
+  'mantur-project-media', 'openchatcut-project-store', 'openchatcut-external-agent',
+  'openchatcut-export', 'openchatcut-export-stage', 'openchatcut-export-destination',
+  'openchatcut-generation-progress', 'openchatcut-media-preview', 'openchatcut-settings',
+  'openchatcut-extract-frames',
+]);
+
+function requestPath(mount: string, req: IncomingMessage): string {
+  const pathname = (req.url ?? '/').split('?')[0];
+  return mount && !pathname.startsWith(mount) ? `${mount}${pathname === '/' ? '' : pathname}` : pathname;
+}
+
+function callbackRoute(pathname: string, req: IncomingMessage): boolean {
+  if (pathname.startsWith('/api/project-store/')) return true;
+  if (pathname === '/api/external-mcp/mcp') return req.method === 'DELETE' || req.method === 'GET';
+  return ['/poll', '/cancellation', '/result', '/unregister'].some((path) => pathname === `/api/external-agent${path}`);
+}
+
+function ownedCatalogRequest(name: string, pathname: string, req: IncomingMessage): boolean {
+  return req.method === 'GET' && (
+    name === 'openchatcut-extension-store' && (pathname === '/api/plugins' || pathname === '/api/plugins/')
+    || name === 'openchatcut-model-packs' && pathname === '/api/model-packs'
+  );
+}
+
+function ownedLocalUploadRequest(name: string, pathname: string, req: IncomingMessage): boolean {
+  return name === 'openchatcut-upload' && pathname === '/upload'
+    && (req.method === 'POST' || req.method === 'PUT') && isIsolatedDevProfile();
+}
+
+function refuse(res: ServerResponse): void {
+  res.statusCode = 503;
+  res.setHeader('Content-Type', 'application/json');
+  res.end(JSON.stringify({ error: 'Editor is shutting down; new work is not accepted' }));
+}
+
+/** One editor process: native MCP cutoff, browser work, backend work, then authoritative saves. */
+export class ManturEditorShutdown {
+  private phase: 'open' | 'preparing' | 'draining' | 'sealed' = 'open';
+  private stopping: Promise<void> | undefined;
+  private readonly transports = new ShutdownWork('Editor MCP transport closure');
+  private transportClosing: Promise<void> | undefined;
+
+  plugin(): Plugin {
+    return {
+      name: 'mantur-editor-shutdown',
+      configureServer: (server) => {
+        if (!(server.httpServer instanceof Server)) throw new Error('Editor shutdown requires its owning HTTP/1 server');
+        server.httpServer.manturShutdown = this;
+        // Both hosts place their provider proxy after this admission gate. Its remote job is not drain-owned.
+        server.middlewares.use('/assemblyai', this.ownRequest('assemblyai-proxy', '/assemblyai', (_req, _res, next) => {
+          recordUnconfirmedEditorProducer('AssemblyAI proxy remote work');
+          next();
+        }));
+      },
+    };
+  }
+
+  stopForShutdown(): Promise<void> {
+    if (this.stopping) return this.stopping;
+    this.phase = 'preparing';
+    this.stopping = (async () => {
+      const budget = Number(process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS);
+      if (!Number.isSafeInteger(budget) || budget < 1) throw new Error('Editor shutdown requires its Host drain deadline');
+      await stopEditorCallsForShutdown();
+      // Browser input stops before its accepted operations finish; their late backend submissions remain valid.
+      await requestEditorShutdown('freeze', budget);
+      this.phase = 'draining';
+      await editorRequests.stop();
+      await stopGenerationJobsForShutdown();
+      await stopEditorMaintenanceForShutdown();
+      await requestEditorShutdown('flush', budget);
+      this.phase = 'sealed';
+      await editorCallbacks.stop();
+      await stopEditorRegistrationsForShutdown();
+      await stopMcpRetirementsForShutdown();
+      await flushServerRunPersistence();
+      await stopProjectStoreForShutdown();
+      await stopEditorMediaProcessesForShutdown();
+      assertRenderShutdownConfirmed();
+    })();
+    return this.stopping;
+  }
+
+  /** After the Host closes its drained MCP client, await the original GET/DELETE handlers before HTTP closure. */
+  finishTransportShutdown(): Promise<void> {
+    return this.transportClosing ??= (async () => {
+      await this.stopForShutdown();
+      await this.transports.stop();
+    })();
+  }
+
+  /** Preserve each route's original promise, including work after its HTTP response is sent. */
+  ownPlugin(plugin: Plugin): Plugin {
+    const configure = plugin.configureServer;
+    if (!configure) return plugin;
+    const handler = typeof configure === 'function' ? configure : configure.handler;
+    const ownRequest = this.ownRequest.bind(this);
+    const configureServer: NonNullable<Plugin['configureServer']> = function (server) {
+      const middlewares = new Proxy(server.middlewares, {
+        get(target, key, receiver) {
+          if (key !== 'use') return Reflect.get(target, key, receiver);
+          return (pathOrHandler: string | Connect.NextHandleFunction, callback?: Connect.NextHandleFunction) => {
+            const mount = typeof pathOrHandler === 'string' ? pathOrHandler : '';
+            const route = typeof pathOrHandler === 'function' ? pathOrHandler : callback;
+            if (!route) throw new Error(`Editor plugin ${plugin.name} registered no middleware`);
+            const wrapped = ownRequest(plugin.name, mount, route);
+            return mount ? target.use(mount, wrapped) : target.use(wrapped);
+          };
+        },
+      });
+      const owned = new Proxy(server, { get: (target, key, receiver) => key === 'middlewares' ? middlewares : Reflect.get(target, key, receiver) });
+      return handler.call(this, owned as ViteDevServer);
+    };
+    return { ...plugin, configureServer: typeof configure === 'function' ? configureServer : { ...configure, handler: configureServer } };
+  }
+
+  private ownRequest(name: string, mount: string, handler: Connect.NextHandleFunction): Connect.NextHandleFunction {
+    return (req, res, next) => {
+      const pathname = requestPath(mount, req);
+      // The Host closes its native transport after the editor acknowledges durable shutdown.
+      const transport = name === 'openchatcut-external-agent' && pathname === '/api/external-mcp/mcp'
+        && (req.method === 'GET' || req.method === 'DELETE');
+      const transportDelete = transport && req.method === 'DELETE';
+      const callback = callbackRoute(pathname, req);
+      if (this.phase === 'sealed' && !transportDelete || this.phase === 'draining' && !callback
+        || this.phase === 'preparing' && name === 'openchatcut-external-agent' && !callback) {
+        refuse(res); return;
+      }
+      const work = transport ? this.transports : callback ? editorCallbacks : editorRequests;
+      const operation = work.admit(async () => {
+        let delegated = false;
+        // Connect types handlers as returning void; feature routes may return their actual async work.
+        const completion: unknown = handler(req, res, (error) => { delegated = true; next(error); });
+        if (!delegated) {
+          if (!OWNED_PLUGINS.has(name) && !ownedCatalogRequest(name, pathname, req) && !ownedLocalUploadRequest(name, pathname, req)) recordUnconfirmedEditorProducer(`${name} ${mount || '/'}`);
+          if (completion === undefined && !res.writableEnded) recordUnconfirmedEditorProducer(`${name}: asynchronous handler without completion`);
+        }
+        await completion;
+        if (!delegated && res.statusCode >= 400) work.recordFailure(new Error(`${name} ${req.method ?? 'UNKNOWN'} ${pathname} returned HTTP ${res.statusCode}`));
+      });
+      void operation.catch(() => { if (!res.headersSent) refuse(res); });
+      return operation;
+    };
+  }
+}
diff --git a/server/plugins/mantur-shutdown.verify.ts b/server/plugins/mantur-shutdown.verify.ts
new file mode 100644
index 0000000..776f92b
--- /dev/null
+++ b/server/plugins/mantur-shutdown.verify.ts
@@ -0,0 +1,127 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import type { Plugin, ViteDevServer } from 'vite';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'callback-failure', 'unknown-producer', 'catalog-read', 'catalog-mutation']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('editor shutdown: 5 HTTP admission, callback completion, catalog and unknown-producer cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-editor-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS = '3000';
+  const { createMiniConnect } = await import('../../desktop/mini-connect.ts');
+  const { ManturEditorShutdown } = await import('./mantur-shutdown.ts');
+  const broker = await import('../external-agent/broker.ts');
+  const lifecycle = await import('./generation-job-lifecycle.ts');
+  const routeErrors: unknown[] = [];
+  const app = createMiniConnect(error => { routeErrors.push(error); });
+  const server = createServer((req, res) => app.handle(req, res));
+  try {
+    const owner = new ManturEditorShutdown();
+    const fixture = { middlewares: app, httpServer: server } as unknown as ViteDevServer;
+    const mount = async (plugin: Plugin) => {
+      const hook = plugin.configureServer!;
+      const handler = typeof hook === 'function' ? hook : hook.handler;
+      await handler.call({} as Parameters<typeof handler['call']>[0], fixture);
+    };
+    await mount(owner.plugin());
+    app.use('/assemblyai', (_req, res) => res.end('test proxy accepted'));
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const callbackEntered = Promise.withResolvers<void>();
+    const callbackRelease = Promise.withResolvers<void>();
+    await mount(owner.ownPlugin({ name: 'openchatcut-export', configureServer(s) {
+      s.middlewares.use('/api/export/work', async (_req, res) => {
+        entered.resolve(); res.end('accepted'); await release.promise;
+      });
+    } }));
+    await mount(owner.ownPlugin({ name: 'openchatcut-project-store', configureServer(s) {
+      s.middlewares.use('/api/project-store/save', async (_req, res) => {
+        callbackEntered.resolve(); res.end('accepted'); await callbackRelease.promise;
+        if (scenario === 'callback-failure') throw new Error('final authoritative callback failed');
+      });
+    } }));
+    await mount(owner.ownPlugin({ name: 'openchatcut-external-agent', configureServer(s) {
+      s.middlewares.use('/api/external-mcp/mcp', (_req, res) => { res.end('native transport closed'); });
+    } }));
+    await mount(owner.ownPlugin({ name: 'unowned-renderer', configureServer(s) {
+      s.middlewares.use('/api/unknown', (_req, res) => { res.end('used'); });
+    } }));
+    for (const [name, path] of [['openchatcut-extension-store', '/api/plugins'], ['openchatcut-model-packs', '/api/model-packs']]) {
+      await mount(owner.ownPlugin({ name, configureServer(s) {
+        s.middlewares.use(path, async (_req, res) => { await Promise.resolve(); res.end('catalog fixture'); });
+      } }));
+    }
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address();
+    assert(address && typeof address !== 'string');
+    const url = `http://127.0.0.1:${address.port}`;
+    const post = (path: string) => fetch(`${url}${path}`, { method: 'POST' });
+    if (scenario === 'catalog-read') {
+      for (const path of ['/api/plugins', '/api/model-packs']) assert.equal((await fetch(`${url}${path}`)).status, 200);
+    }
+    if (scenario === 'catalog-mutation') assert.equal((await post('/api/model-packs')).status, 200);
+    if (scenario === 'unknown-producer') assert.equal((await post('/assemblyai')).status, 200);
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const poll = () => broker.nextEditorCall('project', 'editor', 'revision', AbortSignal.timeout(3000), capability);
+    assert.equal((await post('/api/export/work')).status, 200);
+    await entered.promise;
+    const stopping = owner.stopForShutdown();
+    assert.strictEqual(stopping, owner.stopForShutdown());
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const freeze = await poll();
+    assert.equal(freeze?.arguments.phase, 'freeze');
+    // An operation accepted by the browser before its freeze acknowledgement can still submit its job.
+    const jobEntered = Promise.withResolvers<void>();
+    const jobRelease = Promise.withResolvers<void>();
+    await lifecycle.createGenerationJob({}, async () => {
+      jobEntered.resolve(); await jobRelease.promise; return { path: '/uploads/test.mp4', mimeType: 'video/mp4' };
+    });
+    await jobEntered.promise;
+    assert.equal(broker.settleEditorCall(freeze!.id, 'applied', { phase: 'freeze' }, capability), true);
+    await tick();
+    assert.equal((await post('/api/export/work')).status, 503, 'new work is refused after browser freeze');
+    assert.equal((await post('/api/project-store/save')).status, 200, 'authoritative callbacks stay reachable');
+    await callbackEntered.promise;
+    let flushArrived = false;
+    const flushPending = poll().then(call => { flushArrived = true; return call; });
+    await tick(); assert.equal(flushArrived, false, 'response end does not finish the original request promise');
+    release.resolve(); await tick();
+    assert.equal(flushArrived, false, 'actual accepted generation work still runs');
+    jobRelease.resolve();
+    const flush = await flushPending;
+    assert.equal(flush?.arguments.phase, 'flush');
+    await assert.rejects(lifecycle.createGenerationJob({}, async () => ({ path: '', mimeType: '' })), /shutting down/);
+    assert.equal(broker.settleEditorCall(flush!.id, 'applied', { phase: 'flush' }, capability), true);
+    await broker.unregisterEditor('project', 'editor', capability);
+    let finished = false;
+    void observed.then(() => { finished = true; });
+    await tick(); assert.equal(finished, false, 'final callback completion stays owned after browser unregister');
+    callbackRelease.resolve();
+    const result = await observed;
+    assert.equal(result.ok, scenario === 'accepted' || scenario === 'catalog-read');
+    assert.equal(routeErrors.length, scenario === 'callback-failure' ? 1 : 0);
+    if (!result.ok) assert.match(String(result.error), scenario === 'callback-failure' ? /callbacks failed/ : scenario === 'catalog-mutation' ? /unconfirmed producers: openchatcut-model-packs/ : /unconfirmed producers: AssemblyAI proxy remote work/);
+    assert.equal((await post('/api/export/work')).status, 503);
+    assert.equal((await post('/assemblyai')).status, 503);
+    assert.equal((await fetch(`${url}/api/external-mcp/mcp`, { method: 'DELETE' })).status, 200, 'native close remains available after editor acknowledgement');
+    assert.strictEqual(stopping, owner.stopForShutdown());
+  } finally {
+    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    await rm(root, { recursive: true, force: true });
+  }
+}
