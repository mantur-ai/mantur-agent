new file mode 100644
index 0000000..c0765f6
--- /dev/null
+++ b/server/plugins/project-shutdown.verify.ts
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted-save', 'failed-save']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('project shutdown: 2 isolated process cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-project-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  try {
+    const store = await import('./project-store.ts');
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const writing = store.withSerializedProjectStore(async (locked) => {
+      entered.resolve(); await release.promise;
+      if (scenario === 'failed-save') throw new Error('authoritative write refused');
+      await locked.writeEntry('project:shutdown', { saved: true });
+    });
+    const observedWrite = scenario === 'failed-save' ? assert.rejects(writing, /authoritative write refused/) : writing;
+    await entered.promise;
+    const stopping = store.stopProjectStoreForShutdown();
+    const observedStop = scenario === 'failed-save' ? assert.rejects(stopping, /shutdown is unconfirmed/) : stopping;
+    let stopped = false;
+    void observedStop.then(() => { stopped = true; });
+    assert.strictEqual(stopping, store.stopProjectStoreForShutdown());
+    await assert.rejects(store.setStoredEntry('project:late', {}), /shutting down/);
+    await tick(); assert.equal(stopped, false);
+    release.resolve(); await observedWrite; await observedStop;
+    if (scenario === 'accepted-save') {
+      const profile = (await import('../runtime-profile.ts')).runtimeProfile();
+      const saved = JSON.parse(await readFile(join(profile.projectStore.directory, 'project%3Ashutdown.json'), 'utf8'));
+      assert.deepEqual(saved, { saved: true });
+    }
+  } finally { await rm(root, { recursive: true, force: true }); }
+}
