+import type { renderMedia } from '@remotion/renderer';
+
+/** Audio preparation and final mux stages reported to the export job. */
+export type AudioStage = 'preflight' | 'render' | 'encode';
+
+/** Failed stage with the result of removing private render and mux files. */
+export class AudioFinalizationError extends Error {
+  constructor(cause: Error, stage: AudioStage, cleanupStatus: 'succeeded' | 'failed');
+  stage: AudioStage;
+  cleanupStatus: 'succeeded' | 'failed';
+}
+
+type RenderOptions = Parameters<typeof renderMedia>[0];
+
+/** Whether ordinary H.264/AAC rendering requires final PCM-to-MP4 encoding. */
+export function usesPcmFinalization(options: Pick<RenderOptions, 'codec' | 'muted' | 'separateAudioTo' | 'audioCodec'>, directBinaries: string | null): boolean;
+
+/** Return the original render result only after final output publication and cleanup. */
+export function finalizeH264Audio<Result>(request: {
+  render: (options: RenderOptions) => Promise<Result>;
+  options: RenderOptions;
+  binaries: { ffmpeg: string; ffprobe: string };
+  signal?: AbortSignal;
+  onStage?: (stage: AudioStage) => void;
+}): Promise<Result>;
