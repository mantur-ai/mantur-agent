@@ -0,0 +1,6 @@
+/** Retain the first close operation for an acquired render browser. */
+export function ownRenderBrowser(browser: { close(options: { silent: boolean }): Promise<void>; runner?: unknown }): () => Promise<void>;
+/** Preserve both render and close errors. */
+export function closeRenderBrowser(close: () => Promise<void>, renderingFailure?: { error: unknown }): Promise<void>;
+/** Reject when this process lacks exact render process-and-pipe close evidence. */
+export function assertRenderShutdownConfirmed(): void;
diff --git a/remotion/render-shutdown.mjs b/remotion/render-shutdown.mjs
new file mode 100644
index 0000000..f6552a6
--- /dev/null
+++ b/remotion/render-shutdown.mjs
@@ -0,0 +1,37 @@
+/** Pending browser ownership ends only after its close operation and child-process close event. */
+let acquiredBrowsers = 0;
+const closeFailures = [];
+
+/** Retain the first close promise and its failure, including an earlier abort-triggered close. */
+export function ownRenderBrowser(browser) {
+  acquiredBrowsers += 1;
+  let closing;
+  const processClosed = browser.runner?.manturProcessAndPipesClosed;
+  return () => closing ??= Promise.resolve().then(async () => {
+    await browser.close({ silent: true });
+    if (!(processClosed instanceof Promise)) throw new Error('Rendering browser lacks pinned process-and-pipe close evidence');
+    await processClosed;
+    acquiredBrowsers -= 1;
+  }).catch((error) => {
+    closeFailures.push(error);
+    throw error;
+  });
+}
+
+/** Keep rendering failure and browser cleanup failure as separate evidence. */
+export async function closeRenderBrowser(close, renderingFailure) {
+  try { await close(); }
+  catch (error) {
+    if (renderingFailure) throw new AggregateError([renderingFailure.error, error], 'Rendering and browser closure both failed');
+    throw error;
+  }
+}
+
+/** Reject while any browser is pending or any browser cleanup failed. */
+export function assertRenderShutdownConfirmed() {
+  const failures = [...closeFailures];
+  if (acquiredBrowsers) failures.push(new Error(
+    `This editor has ${acquiredBrowsers} rendering browser(s) without confirmed process-and-pipe closure`,
+  ));
+  if (failures.length) throw new AggregateError(failures, 'Rendering subprocess shutdown is unconfirmed; installation is blocked');
+}
