+          let peak = Math.max(0, expected - Math.round(rate * 0.045));
+          for (let index = peak; index < Math.min(samples.length, expected + Math.round(rate * 0.045)); index++) {
+            if (Math.abs(samples[index]) > Math.abs(samples[peak])) peak = index;
+          }
+          assert(Math.abs(samples[peak]) > 500, `${name}: missing pulse at ${time}`);
+          offsets.push(peak - expected);
+          assert(Math.abs(peak - expected) <= 1, `${name}: pulse at ${time} shifted ${peak - expected} samples`);
+        }
+      }
+      assert(Math.abs(Number(audio.duration_ts) - expectedSamples) <= 1, `${name}: audio end differs from render range`);
+      observations.push({ name, fps, rate, sourceRate, frames: frameCount, offsets, audioSamples: Number(audio.duration_ts), encoder: rendered.encoder?.id ?? 'software' });
+    }
+    assert(!(await readdir(root)).some((name) => name.startsWith('.mantur-audio-')), 'Private export directory leaked');
+    console.log(`audio matrix: ${name} passed`);
+  }
+
+  for (const rate of [32000, 48000]) for (const fps of [24, 30]) {
+    await verify(`full-${rate}-${fps}`, { rate, fps });
+    await verify(`range-mix-${rate}-${fps}`, { rate, fps, range: [fps / 2, fps * 1.5 - 1], kind: 'mix' });
+  }
+  for (const kind of ['none', 'silence', 'zero']) {
+    await verify(`single-frame-${kind}`, { kind, range: [5, 5] });
+  }
+  await verify('explicit-muted', { muted: true });
+  await verify('resample-32k-to-48k', { sourceRate: 32000, rate: 48000, fps: 30, kind: 'mix' });
+  await verify('single-frame-32k-24', { rate: 32000, fps: 24, kind: 'none', range: [5, 5] });
+  await verify('single-frame-32k-30', { rate: 32000, fps: 30, kind: 'silence', range: [5, 5] });
+  if (process.platform === 'darwin') {
+    await verify('hardware-full', { hardware: true });
+    await verify('hardware-range-32k-24', { hardware: true, rate: 32000, fps: 24, range: [12, 35], kind: 'mix' });
+    await verify('hardware-resample-32k-to-48k', { hardware: true, sourceRate: 32000, rate: 48000, kind: 'mix' });
+    await verify('hardware-audio-failure', { hardware: true, failAudio: true });
+  } else console.log('VideoToolbox cases pending: macOS required');
+  const expected = JSON.parse(await readFile(new URL('./tests/expected/audio-finalization.json', import.meta.url), 'utf8'));
+  assert.deepEqual(observations, expected.filter(({ name }) => process.platform === 'darwin' || !name.startsWith('hardware-')));
+  console.log(JSON.stringify({ remotion: VERSION, platform: process.platform, observations }, null, 2));
+} finally { await rm(root, { recursive: true, force: true }); }
