new file mode 100644
index 0000000..7b6431d
--- /dev/null
+++ b/shared/shutdown-work.ts
@@ -0,0 +1,53 @@
+/** Actual accepted work and failures retained until its owning process closes. */
+export class ShutdownWork {
+  private readonly pending = new Set<Promise<unknown>>();
+  private readonly failures: unknown[] = [];
+  private accepting = true;
+  private settled = false;
+  private stopping: Promise<void> | undefined;
+  private readonly name: string;
+
+  constructor(name: string) { this.name = name; }
+
+  /** Reject new submissions synchronously; already accepted work keeps its signals. */
+  freeze(): void { this.accepting = false; }
+
+  /** Register before invoking the producer, including its startup awaits. */
+  admit<T>(work: () => Promise<T>): Promise<T> {
+    if (!this.accepting) return Promise.reject(new Error(`${this.name} is shutting down`));
+    const accepted = Promise.withResolvers<T>();
+    this.track(accepted.promise);
+    try {
+      const result = work();
+      accepted.resolve(result);
+      return result;
+    } catch (error) {
+      accepted.reject(error);
+      throw error;
+    }
+  }
+
+  /** Include follow-on work created by an already accepted producer. */
+  track<T>(work: Promise<T>): Promise<T> {
+    if (this.settled) throw new Error(`${this.name} submitted work after shutdown completed`);
+    this.pending.add(work);
+    void work.then(
+      () => { this.pending.delete(work); },
+      (error: unknown) => { this.recordFailure(error); this.pending.delete(work); },
+    );
+    return work;
+  }
+
+  /** Preserve failures that an existing API converts into a status or diagnostic. */
+  recordFailure(error: unknown): void { this.failures.push(error); }
+
+  /** Await original promises, including work added before their producers settle. */
+  stop(): Promise<void> {
+    this.freeze();
+    return this.stopping ??= (async () => {
+      while (this.pending.size) await Promise.allSettled([...this.pending]);
+      this.settled = true;
+      if (this.failures.length) throw new AggregateError(this.failures, `${this.name} failed; shutdown is unconfirmed`);
+    })();
+  }
+}
