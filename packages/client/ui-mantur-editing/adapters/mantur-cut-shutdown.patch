+      if (scenario === 'failed-flush') {
+        assert.equal(broker.settleEditorCall(flushCall!.id, 'failed', 'browser checkpoint failed', capability), true);
+        const result = await observed;
+        assert.equal(result.ok, false);
+        if (!result.ok) assert.match(String(result.error), /browser checkpoint failed/);
+        assert.equal(broker.isProjectConnected(projectId), true, 'failed browser retains its registration');
+      } else {
+        const entered = Promise.withResolvers<void>();
+        const release = Promise.withResolvers<void>();
+        const heldWrite = store.withSerializedProjectStore(async () => { entered.resolve(); await release.promise; });
+        await entered.promise;
+        assert.equal(broker.settleEditorCall(flushCall!.id, 'applied', { phase: 'flush' }, capability), true);
+        let confirmed = false;
+        void observed.then(() => { confirmed = true; });
+        const unregister = broker.unregisterEditor(projectId, editorId, capability);
+        const unregisterResult = unregister.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+        await tick();
+        assert.equal(broker.isProjectConnected(projectId), false);
+        assert.equal(confirmed, false, 'removing registration is not durable lease release');
+        if (scenario === 'unregister-failure') {
+          await rename(join(root, 'project-store-v1'), join(root, 'before-failure'));
+          await writeFile(join(root, 'project-store-v1'), 'not a directory');
+        }
+        release.resolve(); await heldWrite;
+        const result = await observed;
+        const released = await unregisterResult;
+        assert.equal(result.ok, scenario === 'accepted');
+        assert.equal(released.ok, scenario === 'accepted');
+        if (scenario === 'accepted') {
+          await broker.stopEditorRegistrationsForShutdown();
+          await store.stopProjectStoreForShutdown();
+          const lease = JSON.parse(await readFile(join(root, 'project-store-v1', `${encodeURIComponent(projectEditOwnershipKey(projectId))}.json`), 'utf8'));
+          assert.equal(lease.leaseExpiresAt, 0);
+        } else {
+          await assert.rejects(broker.stopEditorRegistrationsForShutdown(), /failed; shutdown is unconfirmed/);
+        }
+      }
+    }
+  } finally { await rm(root, { recursive: true, force: true }); }
+}
