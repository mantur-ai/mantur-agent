+    const operation = renderMediaOptimized({ serveUrl, composition: { ...base, fps, durationInFrames: fps * 2, props: { rate: sourceRate, kind } },
+      inputProps: { rate: sourceRate, kind }, browserExecutable, codec: 'h264', outputLocation: output,
+      timeoutInMilliseconds: 60_000, sampleRate: rate, frameRange: range, muted,
+      h264Profile: profile, audioBinaries: { ffmpeg: audioFfmpeg, ffprobe }, logLevel: 'error',
+      ffmpegOverride: ({ type, args }) => {
+        if (type === 'stitcher') { renderedVideo = args.at(-1); videoAttempts++; }
