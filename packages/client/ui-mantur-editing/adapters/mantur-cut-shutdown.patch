diff --git a/server/shutdown-runtime.ts b/server/shutdown-runtime.ts
new file mode 100644
index 0000000..ea9a2f0
--- /dev/null
+++ b/server/shutdown-runtime.ts
@@ -0,0 +1,46 @@
+import type { ChildProcess } from 'node:child_process';
+import { basename } from 'node:path';
+import { ShutdownWork } from '../shared/shutdown-work.ts';
+
+export const editorRequests = new ShutdownWork('Editor requests');
+export const editorCallbacks = new ShutdownWork('Editor save and bridge callbacks');
+const maintenance = new ShutdownWork('Editor background maintenance');
+const processes = new ShutdownWork('Editor media subprocess closure');
+const timerStops = new Set<() => void>();
+const unconfirmed = new Set<string>();
+
+/** Preserve original maintenance completion, even if its caller logs and continues. */
+export function trackEditorMaintenance<T>(work: Promise<T>): Promise<T> { return maintenance.track(work); }
+export function recordEditorMaintenanceFailure(error: unknown): void { maintenance.recordFailure(error); }
+
+/** Stop future timer callbacks before waiting for their already started work. */
+export function registerEditorTimerStop(stop: () => void): void { timerStops.add(stop); }
+
+/** This instance used a producer whose complete shutdown is not owned by this integration. */
+export function recordUnconfirmedEditorProducer(name: string): void { unconfirmed.add(name); }
+
+/** Retain the exact child handle's close event, including inherited output pipes. */
+export function trackEditorMediaProcess<T extends ChildProcess>(child: T, operation: string): T {
+  let failure: Error | undefined;
+  const closed = new Promise<void>((resolve, reject) => {
+    child.once('error', (error) => { failure = error; });
+    child.once('close', (_code, signal) => {
+      if (failure && child.pid !== undefined) reject(failure);
+      else if (signal) reject(new Error(`Editor media subprocess ${operation} (${basename(child.spawnfile)}, pid ${child.pid}) ended with ${signal}`));
+      else resolve();
+    });
+  });
+  processes.track(closed);
+  return child;
+}
+
+export async function stopEditorMaintenanceForShutdown(): Promise<void> {
+  for (const stop of timerStops) stop();
+  await maintenance.stop();
+}
+
+/** Call after request, job and maintenance producers stop creating children. */
+export async function stopEditorMediaProcessesForShutdown(): Promise<void> {
+  await processes.stop();
+  if (unconfirmed.size) throw new Error(`Editor shutdown has unconfirmed producers: ${[...unconfirmed].join(', ')}`);
+}
