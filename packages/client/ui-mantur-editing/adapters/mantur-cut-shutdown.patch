new file mode 100644
index 0000000..776f92b
--- /dev/null
+++ b/server/plugins/mantur-shutdown.verify.ts
@@ -0,0 +1,127 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import type { Plugin, ViteDevServer } from 'vite';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'callback-failure', 'unknown-producer', 'catalog-read', 'catalog-mutation']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('editor shutdown: 5 HTTP admission, callback completion, catalog and unknown-producer cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-editor-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS = '3000';
+  const { createMiniConnect } = await import('../../desktop/mini-connect.ts');
+  const { ManturEditorShutdown } = await import('./mantur-shutdown.ts');
+  const broker = await import('../external-agent/broker.ts');
+  const lifecycle = await import('./generation-job-lifecycle.ts');
+  const routeErrors: unknown[] = [];
+  const app = createMiniConnect(error => { routeErrors.push(error); });
+  const server = createServer((req, res) => app.handle(req, res));
+  try {
+    const owner = new ManturEditorShutdown();
+    const fixture = { middlewares: app, httpServer: server } as unknown as ViteDevServer;
+    const mount = async (plugin: Plugin) => {
+      const hook = plugin.configureServer!;
+      const handler = typeof hook === 'function' ? hook : hook.handler;
+      await handler.call({} as Parameters<typeof handler['call']>[0], fixture);
+    };
+    await mount(owner.plugin());
+    app.use('/assemblyai', (_req, res) => res.end('test proxy accepted'));
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const callbackEntered = Promise.withResolvers<void>();
+    const callbackRelease = Promise.withResolvers<void>();
+    await mount(owner.ownPlugin({ name: 'openchatcut-export', configureServer(s) {
+      s.middlewares.use('/api/export/work', async (_req, res) => {
+        entered.resolve(); res.end('accepted'); await release.promise;
+      });
+    } }));
+    await mount(owner.ownPlugin({ name: 'openchatcut-project-store', configureServer(s) {
+      s.middlewares.use('/api/project-store/save', async (_req, res) => {
+        callbackEntered.resolve(); res.end('accepted'); await callbackRelease.promise;
+        if (scenario === 'callback-failure') throw new Error('final authoritative callback failed');
+      });
+    } }));
+    await mount(owner.ownPlugin({ name: 'openchatcut-external-agent', configureServer(s) {
+      s.middlewares.use('/api/external-mcp/mcp', (_req, res) => { res.end('native transport closed'); });
+    } }));
+    await mount(owner.ownPlugin({ name: 'unowned-renderer', configureServer(s) {
+      s.middlewares.use('/api/unknown', (_req, res) => { res.end('used'); });
+    } }));
+    for (const [name, path] of [['openchatcut-extension-store', '/api/plugins'], ['openchatcut-model-packs', '/api/model-packs']]) {
+      await mount(owner.ownPlugin({ name, configureServer(s) {
+        s.middlewares.use(path, async (_req, res) => { await Promise.resolve(); res.end('catalog fixture'); });
+      } }));
+    }
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address();
+    assert(address && typeof address !== 'string');
+    const url = `http://127.0.0.1:${address.port}`;
+    const post = (path: string) => fetch(`${url}${path}`, { method: 'POST' });
+    if (scenario === 'catalog-read') {
+      for (const path of ['/api/plugins', '/api/model-packs']) assert.equal((await fetch(`${url}${path}`)).status, 200);
+    }
+    if (scenario === 'catalog-mutation') assert.equal((await post('/api/model-packs')).status, 200);
+    if (scenario === 'unknown-producer') assert.equal((await post('/assemblyai')).status, 200);
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const poll = () => broker.nextEditorCall('project', 'editor', 'revision', AbortSignal.timeout(3000), capability);
+    assert.equal((await post('/api/export/work')).status, 200);
+    await entered.promise;
+    const stopping = owner.stopForShutdown();
+    assert.strictEqual(stopping, owner.stopForShutdown());
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const freeze = await poll();
+    assert.equal(freeze?.arguments.phase, 'freeze');
+    // An operation accepted by the browser before its freeze acknowledgement can still submit its job.
+    const jobEntered = Promise.withResolvers<void>();
+    const jobRelease = Promise.withResolvers<void>();
+    await lifecycle.createGenerationJob({}, async () => {
+      jobEntered.resolve(); await jobRelease.promise; return { path: '/uploads/test.mp4', mimeType: 'video/mp4' };
+    });
+    await jobEntered.promise;
+    assert.equal(broker.settleEditorCall(freeze!.id, 'applied', { phase: 'freeze' }, capability), true);
+    await tick();
+    assert.equal((await post('/api/export/work')).status, 503, 'new work is refused after browser freeze');
+    assert.equal((await post('/api/project-store/save')).status, 200, 'authoritative callbacks stay reachable');
+    await callbackEntered.promise;
+    let flushArrived = false;
+    const flushPending = poll().then(call => { flushArrived = true; return call; });
+    await tick(); assert.equal(flushArrived, false, 'response end does not finish the original request promise');
+    release.resolve(); await tick();
+    assert.equal(flushArrived, false, 'actual accepted generation work still runs');
+    jobRelease.resolve();
+    const flush = await flushPending;
+    assert.equal(flush?.arguments.phase, 'flush');
+    await assert.rejects(lifecycle.createGenerationJob({}, async () => ({ path: '', mimeType: '' })), /shutting down/);
+    assert.equal(broker.settleEditorCall(flush!.id, 'applied', { phase: 'flush' }, capability), true);
+    await broker.unregisterEditor('project', 'editor', capability);
+    let finished = false;
+    void observed.then(() => { finished = true; });
+    await tick(); assert.equal(finished, false, 'final callback completion stays owned after browser unregister');
+    callbackRelease.resolve();
+    const result = await observed;
+    assert.equal(result.ok, scenario === 'accepted' || scenario === 'catalog-read');
+    assert.equal(routeErrors.length, scenario === 'callback-failure' ? 1 : 0);
+    if (!result.ok) assert.match(String(result.error), scenario === 'callback-failure' ? /callbacks failed/ : scenario === 'catalog-mutation' ? /unconfirmed producers: openchatcut-model-packs/ : /unconfirmed producers: AssemblyAI proxy remote work/);
+    assert.equal((await post('/api/export/work')).status, 503);
+    assert.equal((await post('/assemblyai')).status, 503);
+    assert.equal((await fetch(`${url}/api/external-mcp/mcp`, { method: 'DELETE' })).status, 200, 'native close remains available after editor acknowledgement');
+    assert.strictEqual(stopping, owner.stopForShutdown());
+  } finally {
+    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    await rm(root, { recursive: true, force: true });
+  }
+}
