index 0000000..c73eb50
--- /dev/null
+++ b/src/export/manturExportDestination.ts
@@ -0,0 +1,72 @@
+/** File selection and streamed writes through the embedding Mantur window. */
+import type { BrowserExportFileHandle } from './exportDestination';
+
+const parentOrigin = typeof location === 'undefined' ? null : new URLSearchParams(location.search).get('manturParentOrigin');
+const pending = new Map<string, { resolve(value: unknown): void; reject(error: Error): void }>();
+if (typeof window !== 'undefined') {
+  window.addEventListener('message', (event: MessageEvent<unknown>) => {
+    if (event.source !== window.parent || event.origin !== parentOrigin) return;
+    const data = event.data;
+    if (!data || typeof data !== 'object' || !('type' in data) || data.type !== 'mantur:cut-export-result'
+      || !('version' in data) || data.version !== 1 || !('requestId' in data) || typeof data.requestId !== 'string') return;
+    const entry = pending.get(data.requestId);
+    if (!entry) return;
+    pending.delete(data.requestId);
+    if ('error' in data && data.error) entry.reject(new Error('Mantur export failed'));
+    else entry.resolve('result' in data ? data.result : undefined);
+  });
+  window.addEventListener('pagehide', () => {
+    for (const entry of pending.values()) entry.reject(new Error('Editor closed'));
+    pending.clear();
+  });
+}
+
+function request(value: Record<string, unknown>): Promise<unknown> {
+  return new Promise((resolve, reject) => {
+    if (!parentOrigin) { reject(new Error('Mantur parent unavailable')); return; }
+    const requestId = crypto.randomUUID();
+    pending.set(requestId, { resolve, reject });
+    window.parent.postMessage({ type: 'mantur:cut-export', version: 1, requestId, request: value }, parentOrigin);
+  });
+}
+
+export function isManturEmbedded(): boolean {
+  return Boolean(parentOrigin && typeof window !== 'undefined' && window.parent !== window);
+}
+
+export async function chooseManturExportFile(name: string): Promise<BrowserExportFileHandle | null> {
+  if (!navigator.userActivation?.isActive) throw new Error('Export selection needs a user action');
+  if (await request({ op: 'ready' }) !== true) throw new Error('Mantur picker unavailable');
+  const result = await request({ op: 'pick', name });
+  if (result === null) return null;
+  if (!result || typeof result !== 'object' || !('id' in result) || typeof result.id !== 'string'
+    || !('name' in result) || typeof result.name !== 'string') throw new Error('Invalid Mantur export selection');
+  const id = result.id;
+  return {
+    kind: 'file', name: result.name,
+    queryPermission: async () => 'granted', requestPermission: async () => 'granted',
+    createWritable: async () => {
+      await request({ op: 'start', id });
+      let offset = 0;
+      return {
+        write: async (data: Blob | BufferSource | string) => {
+          const blob = data instanceof Blob ? data : new Blob([data as BlobPart]);
+          const reader = blob.stream().getReader();
+          try {
+            for (;;) {
+              const chunk = await reader.read();
+              if (chunk.done) break;
+              for (let start = 0; start < chunk.value.byteLength; start += 1024 * 1024) {
+                const bytes = chunk.value.slice(start, start + 1024 * 1024);
+                await request({ op: 'write', id, offset, bytes });
+                offset += bytes.byteLength;
+              }
+            }
+          } finally { reader.releaseLock(); }
+        },
+        close: async () => { await request({ op: 'finish', id }); },
+        abort: async () => { await request({ op: 'abort', id }); },
+      };
+    },
+  };
+}
