+++ b/server/plugins/mcp-transport-shutdown.verify.ts
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import type { Plugin, ViteDevServer } from 'vite';
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'save-failure', 'stream-failure', 'delete-failure']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('MCP shutdown: real SDK SSE, late save, stream completion and retained failures passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-mcp-stream-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS = '3000';
+  process.env.OPENCHATCUT_MCP_TOKEN = randomUUID();
+  const { createMiniConnect } = await import('../../desktop/mini-connect.ts');
+  const { ManturEditorShutdown } = await import('./mantur-shutdown.ts');
+  const { externalAgentPlugin } = await import('./external-agent.ts');
+  const broker = await import('../external-agent/broker.ts');
+  const app = createMiniConnect(() => {});
+  const server = createServer((req, res) => app.handle(req, res));
+  const client = new Client({ name: 'shutdown-regression', version: '1' });
+  const saveRelease = Promise.withResolvers<void>();
+  const streamEntered = Promise.withResolvers<void>();
+  const streamEnded = Promise.withResolvers<void>();
+  const streamRelease = Promise.withResolvers<void>();
+  const owner = new ManturEditorShutdown();
+  const deadline = async <T>(work: Promise<T>): Promise<T> => {
+    let timer: ReturnType<typeof setTimeout>;
+    try {
+      return await Promise.race([work, new Promise<never>((_, reject) => { timer = setTimeout(() => reject(new Error('drain is waiting on the live MCP stream')), 1500); })]);
+    } finally { clearTimeout(timer!); }
+  };
+  try {
+    const mount = async (plugin: Plugin) => {
+      const hook = plugin.configureServer!;
+      const configure = typeof hook === 'function' ? hook : hook.handler;
+      await configure.call({} as never, { middlewares: app, httpServer: server, config: { logger: { error() {} } } } as unknown as ViteDevServer);
+    };
+    await mount(owner.plugin());
+    const native = externalAgentPlugin();
+    const hook = native.configureServer!;
+    const configure = typeof hook === 'function' ? hook : hook.handler;
+    await mount(owner.ownPlugin({ ...native, configureServer(s) {
+      const middlewares = new Proxy(s.middlewares, { get(target, key, receiver) {
+        if (key !== 'use') return Reflect.get(target, key, receiver);
+        return (path: string, handler: (req: import('node:http').IncomingMessage, res: import('node:http').ServerResponse, next: (error?: unknown) => void) => unknown) => target.use(path, async (req, res, next) => {
+          const get = path === '/api/external-mcp/mcp' && req.method === 'GET';
+          const deleting = path === '/api/external-mcp/mcp' && req.method === 'DELETE';
+          if (get) streamEntered.resolve();
+          await handler(req, res, next);
+          if (get) {
+            streamEnded.resolve(); await streamRelease.promise;
+            if (scenario === 'stream-failure') throw new Error('late native stream completion failed');
+          }
+          if (deleting) {
+            await streamRelease.promise;
+            if (scenario === 'delete-failure') throw new Error('late native DELETE completion failed');
+          }
+        });
+      } });
+      return configure.call(this, new Proxy(s, { get: (target, key, receiver) => key === 'middlewares' ? middlewares : Reflect.get(target, key, receiver) }));
+    } }));
+    await mount(owner.ownPlugin({ name: 'openchatcut-project-store', configureServer(s) {
+      s.middlewares.use('/api/project-store/test-save', async (_req, res) => {
+        res.end('accepted'); await saveRelease.promise;
+        if (scenario === 'save-failure') throw new Error('late save failed');
+      });
+    } }));
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address(); assert(address && typeof address !== 'string');
+    const origin = `http://127.0.0.1:${address.port}`;
+    const transport = new StreamableHTTPClientTransport(new URL('/api/external-mcp/mcp', origin), {
+      requestInit: { headers: { Authorization: `Bearer ${process.env.OPENCHATCUT_MCP_TOKEN}` } },
+    });
+    await client.connect(transport);
+    await deadline(streamEntered.promise);
+    assert((await client.listTools()).tools.length > 0);
+    assert.equal((await fetch(`${origin}/api/project-store/test-save`, { method: 'POST' })).status, 200);
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const stopping = owner.stopForShutdown();
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const poll = () => broker.nextEditorCall('project', 'editor', 'revision', AbortSignal.timeout(3000), capability);
+    for (const phase of ['freeze', 'flush']) {
+      const call = await poll(); assert.equal(call?.arguments.phase, phase);
+      assert.equal(broker.settleEditorCall(call!.id, 'applied', { phase }, capability), true);
+    }
+    await broker.unregisterEditor('project', 'editor', capability);
+    let drained = false; void observed.then(() => { drained = true; });
+    await tick(); assert.equal(drained, false, 'the late save remains owned while SSE is open');
+    saveRelease.resolve();
+    const result = await deadline(observed);
+    assert.equal(result.ok, scenario !== 'save-failure');
+    if (!result.ok) {
+      assert.match(String(result.error), /callbacks failed/);
+      assert.strictEqual(stopping, owner.stopForShutdown());
+    } else {
+      assert.equal((await fetch(`${origin}/api/project-store/test-save`, { method: 'POST' })).status, 503);
+      if (scenario === 'delete-failure') await transport.terminateSession();
+      await client.close();
+      await deadline(streamEnded.promise);
+      const closing = owner.finishTransportShutdown();
+      assert.strictEqual(closing, owner.finishTransportShutdown());
+      const closed = closing.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+      let finished = false; void closed.then(() => { finished = true; });
+      await tick(); assert.equal(finished, false, 'client close does not discard the original GET handler tail');
+      streamRelease.resolve();
+      const final = await deadline(closed);
+      assert.equal(final.ok, scenario !== 'stream-failure' && scenario !== 'delete-failure');
+      if (!final.ok) assert.match(String(final.error), /MCP transport closure failed/);
+    }
+  } finally {
+    saveRelease.resolve(); streamRelease.resolve(); await client.close();
+    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    await rm(root, { recursive: true, force: true });
+  }
+}
