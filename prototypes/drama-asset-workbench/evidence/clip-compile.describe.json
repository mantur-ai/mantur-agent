  "params_schema": {
    "allOf": [
      {
        "oneOf": [
          {
            "not": {
              "required": [
                "script_text"
              ]
            },
            "required": [
              "script_url"
            ]
          },
          {
            "not": {
              "required": [
                "script_url"
              ]
            },
            "required": [
              "script_text"
            ]
          }
        ]
      },
      {
        "oneOf": [
          {
            "not": {
              "required": [
                "asset_manifest"
              ]
            },
            "required": [
              "asset_manifest_url"
            ]
          },
          {
            "not": {
              "required": [
                "asset_manifest_url"
              ]
            },
            "required": [
              "asset_manifest"
            ]
          }
        ]
      }
    ],
    "async": true,
    "fields": [
      {
        "desc": "执行动作",
        "enum": [
          "compile"
        ],
        "name": "action",
        "type": "string",
        "default": "compile",
        "required": false
      },
      {
        "desc": "Worker可访问的UTF-8完整剧本URL；与script_text二选一，下载验证后以Markdown input_file.file_data传给Responses",
        "name": "script_url",
        "type": "string",
        "required": false
      },
      {
        "desc": "UTF-8完整剧本文本；与script_url二选一，验证后以Markdown input_file.file_data传给Responses",
        "name": "script_text",
        "type": "string",
        "required": false,
        "maxLength": 10000000,
        "minLength": 1
      },
      {
        "desc": "剧本资产提取算子输出的资产JSON URL；与asset_manifest二选一，下载校验后以JSON input_file.file_data传给Responses",
        "name": "asset_manifest_url",
        "type": "string",
        "required": false
      },
      {
        "desc": "剧本资产提取算子输出的四Sheet同源JSON；与asset_manifest_url二选一，校验后以JSON input_file.file_data传给Responses",
        "name": "asset_manifest",
        "type": "object",
        "required": false
      },
      {
        "desc": "输出文件使用的剧名",
        "name": "project_name",
        "type": "string",
        "required": false,
        "maxLength": 200
      },
      {
        "desc": "制作起始集；不传时覆盖剧本全部集数",
        "name": "episode_start",
        "type": "integer",
        "required": false
      },
      {
        "desc": "制作结束集；传入时必须同时提供episode_start",
        "name": "episode_end",
        "type": "integer",
        "required": false
      },
      {
        "desc": "Seedance视频画幅",
        "enum": [
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "1:1",
          "21:9"
        ],
        "name": "ratio",
        "type": "string",
        "default": "9:16",
        "required": false
      },
      {
        "desc": "视频分辨率",
        "enum": [
          "480p",
          "720p",
          "1080p"
        ],
        "name": "resolution",
        "type": "string",
        "default": "480p",
        "required": false
      },
      {
        "desc": "写入Seedance请求体的模型ID",
        "name": "video_model",
        "type": "string",
        "default": "doubao-seedance-2-0-260128",
        "required": false,
        "maxLength": 200
      },
      {
        "desc": "每集Clip数量软目标下界；不会作为失败条件",
        "name": "minimum_clips_per_episode",
        "type": "integer",
        "default": 4,
        "required": false
      },
      {
        "desc": "每集Clip数量软目标",
        "name": "preferred_clips_per_episode",
        "type": "integer",
        "default": 5,
        "required": false
      },
      {
        "desc": "每集Clip数量软目标上界；内容过长时允许超出",
        "name": "maximum_clips_per_episode",
        "type": "integer",
        "default": 6,
        "required": false
      },
      {
        "desc": "每集应尽量守住的强下限目标；一次规划优先留出安全余量，不以失败重试实现",
        "name": "minimum_episode_seconds",
        "type": "integer",
        "default": 60,
        "required": false
      },
      {
        "desc": "每集时长软上界；内容过长时保留完整剧情并允许超出",
        "name": "maximum_episode_seconds",
        "type": "integer",
        "default": 90,
        "required": false
      },
      {
        "desc": "单Clip时长硬下界，受当前视频模型限制",
        "name": "minimum_clip_seconds",
        "type": "integer",
        "default": 5,
        "required": false
      },
      {
        "desc": "单Clip时长硬上界，受当前视频模型限制",
        "name": "maximum_clip_seconds",
        "type": "integer",
        "default": 15,
        "required": false
      },
      {
        "desc": "地区预设；china=中国版，western=欧美版",
        "enum": [
          "china",
          "western"
        ],
        "name": "target_region",
        "type": "string",
        "default": "western",
        "required": false
      },
      {
        "desc": "对白输出语言；中国版固定zh，欧美版固定en；不传时由target_region确定",
        "enum": [
          "en",
          "zh"
        ],
        "name": "dialogue_language",
        "type": "string",
        "required": false
      },
      {
        "desc": "15秒可容纳的英文对白词数估计，用于密度警告",
        "name": "dialogue_words_per_15_seconds",
        "type": "integer",
        "default": 40,
        "maximum": 80,
        "minimum": 10,
        "required": false
      },
      {
        "desc": "15秒可容纳的中文对白汉字数估计，用于中国版密度警告",
        "name": "dialogue_chinese_characters_per_15_seconds",
        "type": "integer",
        "default": 55,
        "maximum": 100,
        "minimum": 20,
        "required": false
      },
      {
        "desc": "缺音色时由视频模型直出或阻断",
        "enum": [
          "ai_direct",
          "error"
        ],
        "name": "missing_voice_policy",
        "type": "string",
        "default": "ai_direct",
        "required": false
      },
      {
        "desc": "整剧统一美术风格与世界观硬约束",
        "name": "visual_style",
        "type": "string",
        "required": false,
        "maxLength": 12000
      },
      {
        "desc": "整剧负面约束；可见文字语言由target_region确定",
        "name": "visual_negative",
        "type": "string",
        "required": false,
        "maxLength": 12000
      },
      {
        "desc": "逐Clip重复写入的其他硬性限制；无需重复填写固定的不要背景音乐/不要字幕",
        "name": "hard_constraints",
        "type": "string",
        "required": false,
        "maxLength": 12000
      },
      {
        "desc": "Seedance请求是否生成同步对白与环境音",
        "name": "generate_audio",
        "type": "boolean",
        "default": true,
        "required": false
      },
      {
        "desc": "Seedance随机种子；-1表示随机",
        "name": "seed",
        "type": "integer",
        "default": -1,
        "required": false
      },
      {
        "desc": "稳定幂等键；相同键和请求返回原task_id",
        "name": "idempotency_key",
        "type": "string",
        "required": false,
        "maxLength": 200,
        "minLength": 8
      }
    ]
  },
