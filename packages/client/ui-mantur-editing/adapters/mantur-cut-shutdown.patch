+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address(); assert(address && typeof address !== 'string');
+    const url = `http://127.0.0.1:${address.port}/api/extract-frames`;
+    let post!: ReturnType<typeof request>;
+    const response = new Promise<{ status: number; body: Record<string, unknown> }>((resolve, reject) => {
+      post = request(url, { method: 'POST', headers: { 'Content-Type': 'application/json' } }, res => {
+        const chunks: Buffer[] = []; res.on('data', chunk => chunks.push(chunk));
+        res.on('end', () => { resolve({ status: res.statusCode!, body: JSON.parse(Buffer.concat(chunks).toString()) }); });
+        res.on('error', reject);
+      });
+      post.on('error', reject); post.write('{"src":');
+    });
+    let responded = false; void response.then(() => { responded = true; });
+    await admitted.promise;
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const stopping = owner.stopForShutdown();
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const poll = () => broker.nextEditorCall('project', 'editor', 'revision', AbortSignal.timeout(10000), capability);
+    const freeze = await poll(); assert.equal(freeze?.arguments.phase, 'freeze');
+    broker.settleEditorCall(freeze!.id, 'applied', { phase: 'freeze' }, capability);
+    await tick();
+    assert.equal((await fetch(url, { method: 'POST', body: '{}' })).status, 503, 'new extraction is refused after cutoff');
+    const body = scenario === 'automatic' || scenario === 'scene-failure' ? { src: '/media/uploads/fresh-test.mp4', count: 2 } : { src: '/media/uploads/fresh-test.mp4', sourceTimesMs: [0, 200] };
+    post.end(JSON.stringify(body).slice('{"src":'.length));
