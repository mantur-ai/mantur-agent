+import { setImmediate as tick } from 'node:timers/promises';
+import type { Plugin, ViteDevServer } from 'vite';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'automatic', 'pipe', 'cleanup-failure', 'partial-failure', 'scene-failure', 'grid-cleanup-failure']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('extract frames: real JPEG, accepted work, source integrity, pipe close and retained failures passed');
+} else {
+  const expectedFailure = ['cleanup-failure', 'partial-failure', 'scene-failure', 'grid-cleanup-failure'].includes(scenario);
+  const root = await mkdtemp(join(tmpdir(), 'mantur-extract-shutdown-'));
+  const removeRoot = fsPromises.rm;
+  try {
+  const scratch = join(root, 'tmp'); await mkdir(scratch);
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_DEV_PROFILE_ID = randomUUID();
+  process.env.TMPDIR = scratch;
+  process.env.MANTUR_CUT_DRAIN_TIMEOUT_MS = '10000';
+  const { ffmpegBin } = await import('../media-binaries.ts');
+  const ffmpeg = ffmpegBin();
+  const { uploadDir } = await import('../media-dir.ts');
+  const media = uploadDir(); await mkdir(media, { recursive: true });
+  const video = join(media, 'fresh-test.mp4');
+  execFileSync(ffmpeg, ['-nostdin', '-v', 'error', '-f', 'lavfi', '-i', 'testsrc2=size=160x90:rate=10', '-t', '0.5', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', video], { timeout: 15000 });
+  const originalVideo = await readFile(video);
+  const releaseFile = join(root, 'release');
+  const wrapper = join(root, 'ffmpeg.cjs');
+  const pipeEntered = Promise.withResolvers<ReturnType<typeof spawn>>();
+  const nativeSpawn = childProcess.spawn;
+  const nativeSpawnSync = childProcess.spawnSync;
+  if (scenario === 'pipe' || scenario === 'partial-failure' || scenario === 'scene-failure') {
+    await writeFile(wrapper, `#!${process.execPath}\nconst {spawn}=require('node:child_process'); const fs=require('node:fs');
+const args=process.argv.slice(2);
+if (${JSON.stringify(scenario)}==='scene-failure' && args.some(x=>x.includes('showinfo'))) process.exit(7);
+if (${JSON.stringify(scenario)}==='partial-failure' && /f-1\\.jpg$/.test(args.at(-1))) process.exit(7);
+const work=spawn(${JSON.stringify(ffmpeg)},args,{stdio:['ignore',1,2]});
+work.on('error',e=>{console.error(e);process.exit(1)});
+work.on('close',code=>{
+ if(code===0 && ${JSON.stringify(scenario)}==='pipe' && /f-0\\.jpg$/.test(args.at(-1))) {
+  const holder=spawn(process.execPath,['-e',${JSON.stringify(`const fs=require('node:fs');const timer=setInterval(()=>{if(fs.existsSync(${JSON.stringify(releaseFile)})){clearInterval(timer);process.stderr.write('pipe released');}},10);`)}],{stdio:['ignore','ignore',2]});
+  holder.once('spawn',()=>process.exit(0));
+ } else process.exit(code??1);
+});\n`);
+    process.env.OPENCHATCUT_FFMPEG = wrapper;
+    childProcess.spawn = ((...args: Parameters<typeof nativeSpawn>) => {
+      const child = args[0] === wrapper && Array.isArray(args[1])
+        ? nativeSpawn(process.execPath, [wrapper, ...args[1]], args[2]) : nativeSpawn(...args);
+      if (args[0] === wrapper && Array.isArray(args[1]) && /f-0\.jpg$/.test(String(args[1].at(-1)))) pipeEntered.resolve(child);
+      return child;
+    }) as typeof nativeSpawn;
+    childProcess.spawnSync = ((...args: Parameters<typeof nativeSpawnSync>) => args[0] === wrapper && Array.isArray(args[1])
+      ? nativeSpawnSync(process.execPath, [wrapper, ...args[1]], args[2]) : nativeSpawnSync(...args)) as typeof nativeSpawnSync;
+    syncBuiltinESMExports();
+  }
+  const nativeRm = fsPromises.rm;
+  const cleanupEntered = Promise.withResolvers<void>();
+  const cleanupRelease = Promise.withResolvers<void>();
+  fsPromises.rm = async (path, options) => {
+    if (scenario === 'grid-cleanup-failure' && String(path).startsWith(scratch) && basename(String(path)).startsWith('cc-grid-')) throw new Error('grid cleanup refused');
+    if (String(path).startsWith(scratch) && basename(String(path)).startsWith('cc-frames-')) {
