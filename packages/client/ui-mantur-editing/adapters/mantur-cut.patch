index 0000000..6a24847
--- /dev/null
+++ b/server/plugins/mantur-terminal-draft.verify.ts
@@ -0,0 +1,221 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import type { StoredExternalProposal } from '../../src/persist/externalProposalStore';
+import type { ExternalBridgePersistence } from '../../src/agent/external-proposal-apply';
+
+// Separate processes exercise the production JSON store, parser and runtime hydration.
+const phase = process.argv[2];
+if (!phase) {
+  const directory = await mkdtemp(join(tmpdir(), 'mantur-terminal-draft-'));
+  try {
+    for (const stage of ['write', 'read']) {
+      execFileSync(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), stage], {
+        env: { ...process.env, OPENCHATCUT_DEV_PROFILE_ID: '7686bde7-e08e-47a1-90f9-53faf21662b4',
+          OPENCHATCUT_DATA_DIR: directory, OPENCHATCUT_SQLITE_STORE: '0' },
+        stdio: 'inherit', timeout: 30000,
+      });
+    }
+    console.log('PASS: terminal draft contents survive a process restart; stale review/apply stay closed.');
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+} else {
+  const store = await import('./project-store');
+  const { configureSharedKvBackend } = await import('../../src/persist/sharedKv');
+  const { loadExternalProposal, saveExternalProposal } = await import('../../src/persist/externalProposalStore');
+  const { makeDraft } = await import('../../src/editor/store');
+  const { docFromTimeline } = await import('../../src/persist/projectStore');
+  const { INITIAL } = await import('../../src/editor/initial');
+  const { ExternalBridgeRuntime } = await import('../../src/agent/external-bridge-runtime');
+  const { DEFAULT_EXTERNAL_BRIDGE_PERSISTENCE } = await import('../../src/agent/external-bridge-persistence-defaults');
+  const { restoreExternalEditSession, finishExternalEditSession } = await import('../../src/agent/external-edit-session');
+  const { storedExternalSession } = await import('../../src/agent/external-bridge-session');
+  let failCheckpoint = false;
+  let failLedger = false;
+  let beforeCheckpoint: ((value: unknown) => Promise<void>) | undefined;
+  configureSharedKvBackend({
+    async get<T>(key: string): Promise<T | undefined> {
+      const entry = await store.getStoredEntry(key);
+      return entry.found ? entry.value as T : undefined;
+    },
+    async set(key, value) {
+      if (failCheckpoint && key.startsWith('external-proposal:')) throw new Error('checkpoint write failed');
+      if (key.startsWith('external-proposal:')) await beforeCheckpoint?.(value);
+      await store.setStoredEntry(key, value);
+    },
+    delete: store.deleteStoredEntry,
+    keys: async () => Object.keys((await store.readStore()).entries),
+    async writeAgentRuntime(input) {
+      if (failLedger) throw new Error('ledger write failed');
+      return store.writeAgentRuntime(input);
+    },
+    updateAgentRunLease: store.updateStoredAgentRunLease,
+  });
+  const projectId = 'terminal-draft';
+  const fixture = join(process.env.OPENCHATCUT_DATA_DIR!, 'expected.json');
+  const runtimeFor = (id: string, live: ReturnType<typeof makeDraft>, persistence?: ExternalBridgePersistence) => new ExternalBridgeRuntime(
+    id, 'test-editor', () => ({ commands: live.commands, getDoc: live.getDoc, getState: live.getState,
+      getCreativeMode: () => null, getProjectId: () => id, templates: [], audio: [] }), () => {}, persistence,
+  );
+  if (phase === 'write') {
+    const base = docFromTimeline({ ...INITIAL, items: [] });
+    const live = makeDraft(base);
+    const runtime = runtimeFor(projectId, live);
+    try {
+      const binding = runtime.binding();
+      const begun = await runtime.execute('begin_edit_session', { approvalMode: 'auto' }, binding) as { editSessionId: string };
+      await runtime.execute('set_aspect_ratio', { editSessionId: begun.editSessionId, ratio: '9:16' }, binding);
+      const drafting = await loadExternalProposal(projectId);
+      assert(drafting?.draftCheckpoint);
+      assert.deepEqual(drafting.draftCheckpoint.baseDoc, JSON.parse(JSON.stringify(base)));
+      live.commands.setAspect(720, 720, 'contain');
+      const changedDoc = live.getDoc();
+      await store.setStoredEntry(`project:${projectId}`, changedDoc);
+      failCheckpoint = true;
+      await assert.rejects(runtime.execute('read_project', { editSessionId: begun.editSessionId }, binding), /checkpoint write failed/);
+      failCheckpoint = false;
+      assert.deepEqual(await loadExternalProposal(projectId), drafting,
+        'failed terminal persistence leaves the durable checkpoint intact');
+      failLedger = true;
+      await assert.rejects(runtime.execute('read_project', { editSessionId: begun.editSessionId }, binding), /ledger write failed/);
+      failLedger = false;
+      const records = await runtime.execute('list_edit_sessions', {}, runtime.binding()) as Array<{ status: string }>;
+      assert.equal(records[0]?.status, 'stale', 'durable terminal status closes memory before ledger finalization');
+      const stale = await loadExternalProposal(projectId);
+      assert.equal(stale?.status, 'stale');
+      assert.deepEqual(stale?.draftCheckpoint, drafting.draftCheckpoint);
+      await assert.rejects(runtime.execute('review_edit_session', { editSessionId: begun.editSessionId }, runtime.binding()), /not drafting/);
+      assert.deepEqual(live.getDoc(), changedDoc);
+      await writeFile(fixture, JSON.stringify({ drafting, changedDoc }));
+      await saveExternalProposal(`${projectId}-hydrate`, drafting);
+      for (const status of ['cancelled', 'failed'] as const) {
+        const restored = restoreExternalEditSession({ ...stale!, status }, changedDoc);
+        const terminal = finishExternalEditSession(restored, status);
+        assert.equal(terminal.draft, null);
+        await saveExternalProposal(`${projectId}-${status}`, storedExternalSession(terminal));
+      }
+      const initialId = `${projectId}-initial`;
+      const initialEntered = Promise.withResolvers<StoredExternalProposal>();
+      const initialRelease = Promise.withResolvers<void>();
+      const writes: string[] = [];
+      const initialRuntime = runtimeFor(initialId, makeDraft(base), {
+        ...DEFAULT_EXTERNAL_BRIDGE_PERSISTENCE,
+        async saveExternalProposal(id, record) {
+          writes.push(`${record.status}:start`);
+          if (record.status === 'drafting') {
+            initialEntered.resolve(record);
+            await initialRelease.promise;
+          }
+          await saveExternalProposal(id, record);
+          writes.push(`${record.status}:saved`);
+        },
+      });
+      const beginning = initialRuntime.execute('begin_edit_session', {}, initialRuntime.binding());
+      const initialRecord = await initialEntered.promise;
+      const cancelling = initialRuntime.execute('discard_edit_session', {
+        editSessionId: initialRecord.sessionId,
+      }, initialRuntime.binding());
+      try {
+        // The cancellation's queued callback gets a microtask turn; no timer or filesystem timing is assumed.
+        await Promise.resolve();
+        assert.deepEqual(writes, ['drafting:start'], 'initial checkpoint owns the write queue until its save settles');
+        initialRelease.resolve();
+        await Promise.all([beginning, cancelling]);
+        assert.deepEqual(writes, ['drafting:start', 'drafting:saved', 'cancelled:start', 'cancelled:saved']);
+        assert.equal((await loadExternalProposal(initialId))?.status, 'cancelled');
+      } finally {
+        initialRelease.resolve();
+        await Promise.allSettled([beginning, cancelling]);
+        await initialRuntime.disconnect();
+      }
+      const lateId = `${projectId}-late`;
+      const lateLive = makeDraft(base);
+      const lateRuntime = runtimeFor(lateId, lateLive);
+      let release!: () => void;
+      let reached!: () => void;
+      const held = new Promise<void>(resolve => { release = resolve; });
+      const started = new Promise<void>(resolve => { reached = resolve; });
+      try {
+        const lateBinding = lateRuntime.binding();
+        const lateSession = await lateRuntime.execute('begin_edit_session', {}, lateBinding) as { editSessionId: string };
+        await lateRuntime.execute('set_aspect_ratio', { editSessionId: lateSession.editSessionId, ratio: '1:1' }, lateBinding);
+        beforeCheckpoint = async value => {
+          const record = value as StoredExternalProposal;
+          if (record.status === 'drafting' && record.operationCount === 2) { reached(); await held; }
+        };
+        const pending = lateRuntime.execute('set_aspect_ratio', { editSessionId: lateSession.editSessionId, ratio: '9:16' }, lateBinding);
+        await started;
+        const cancelled = lateRuntime.execute('discard_edit_session', { editSessionId: lateSession.editSessionId }, lateBinding);
+        // Let cancellation reach its first persistence await while the tool's write is held.
+        await new Promise<void>(resolve => setImmediate(resolve));
+        release();
+        await Promise.all([pending, cancelled]);
+        beforeCheckpoint = undefined;
+        const record = await loadExternalProposal(lateId);
+        assert.equal(record?.status, 'cancelled', 'a late drafting write cannot resurrect a terminal session');
+        assert.equal(record.draftCheckpoint?.operations.length, 2);
+        await writeFile(join(process.env.OPENCHATCUT_DATA_DIR!, 'late-expected.json'), JSON.stringify(record));
+        assert.deepEqual(lateLive.getDoc(), base);
+      } finally {
+        release();
+        beforeCheckpoint = undefined;
+        await lateRuntime.disconnect();
+      }
+    } finally {
+      failCheckpoint = false;
+      failLedger = false;
+      await runtime.disconnect();
+    }
+  } else if (phase === 'read') {
+    const { drafting, changedDoc } = JSON.parse(await readFile(fixture, 'utf8')) as {
+      drafting: StoredExternalProposal; changedDoc: Parameters<typeof makeDraft>[0];
+    };
+    for (const status of ['stale', 'cancelled', 'failed'] as const) {
+      const id = status === 'stale' ? projectId : `${projectId}-${status}`;
+      const record = await loadExternalProposal(id);
+      assert(record);
+      assert.equal(record.status, status);
+      assert.deepEqual(record.draftCheckpoint, drafting.draftCheckpoint);
+      const live = makeDraft(changedDoc);
+      const runtime = runtimeFor(id, live);
+      try {
+        await runtime.hydrate(record);
+        const recovered = await runtime.execute('recover_edit_session', {
+          editSessionId: record.sessionId, action: 'resume',
+        }, runtime.binding()) as { status: string };
