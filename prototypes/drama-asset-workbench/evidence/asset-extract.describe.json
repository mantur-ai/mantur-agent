  "params_schema": {
    "async": true,
    "oneOf": [
      {
        "not": {
          "required": [
            "script_text"
          ]
        },
        "required": [
          "script_url"
        ]
      },
      {
        "not": {
          "required": [
            "script_url"
          ]
        },
        "required": [
          "script_text"
        ]
      }
    ],
    "fields": [
      {
        "desc": "执行动作，当前只支持整剧资产提取",
        "enum": [
          "extract"
        ],
        "name": "action",
        "type": "string",
        "default": "extract",
        "required": false
      },
      {
        "desc": "地区预设；china=中国版（中文/普通话/中文可见文字），western=欧美版（英文/英文音色/英文可见文字）",
        "enum": [
          "china",
          "western"
        ],
        "name": "target_region",
        "type": "string",
        "default": "western",
        "required": false
      },
      {
        "desc": "ManturHub文件或Worker可访问的 UTF-8 .md/.txt 完整剧本 URL；与 script_text 二选一。Worker下载验证后以 Markdown input_file.file_data 交给 Responses",
        "name": "script_url",
        "type": "string",
        "required": false
      },
      {
        "desc": "UTF-8 完整剧本文本；与 script_url 二选一，Worker验证后以 Markdown input_file.file_data 交给 Responses",
        "name": "script_text",
        "type": "string",
        "required": false,
        "maxLength": 10000000,
        "minLength": 1
      },
      {
        "desc": "输出文件使用的剧本名称",
        "name": "script_name",
        "type": "string",
        "required": false,
        "maxLength": 200
      },
      {
        "desc": "项目级美术世界观和角色风格；不传时从剧本提炼",
        "name": "project_style",
        "type": "string",
        "required": false,
        "maxLength": 12000
      },
      {
        "desc": "项目级负面约束，会合并到资产负面提示词",
        "name": "visual_negative",
        "type": "string",
        "required": false,
        "maxLength": 12000
      },
      {
        "desc": "视觉参考图列表，最多10张，推荐约8张：主要角色3-4张、场景/世界观2张、画风/材质1-2张、关键道具1张。每张包含可公开读取的url、用途标签label和可选说明note。模型只分析并输出参考绑定建议，实际生图仍需将选中的原图直接传给生图模型。",
        "name": "reference_images",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "url",
            "label"
          ],
          "properties": {
            "url": {
              "desc": "可由GPT访问的HTTP/HTTPS图片URL",
              "type": "string"
            },
            "note": {
              "desc": "可选补充说明，不替代图片内容",
              "type": "string",
              "maxLength": 1000
            },
            "label": {
              "desc": "用户定义用途，如角色A、学院场景、暖色材质或设定板版式",
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          }
        },
        "maxItems": 10,
        "required": false
      },
      {
        "desc": "稳定幂等键；相同键和相同请求返回原 task_id",
        "name": "idempotency_key",
        "type": "string",
        "required": false,
        "maxLength": 200,
        "minLength": 8
      }
    ]
  },
