@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict';
+import { setImmediate as tick } from 'node:timers/promises';
+import { INITIAL } from '../editor/initial';
+import { makeDraft } from '../editor/store';
+import { docFromTimeline, saveProject } from '../persist/projectStore';
+import { saveAutomaticVersion } from '../persist/versionStore';
+import { loadExternalProposal, saveExternalProposal } from '../persist/externalProposalStore';
+import { loadAgentRuntimeSidecar, stopAgentRuntimeWritesForShutdown } from '../persist/agentRuntimeStore';
+import { ExternalBridgeRuntime } from './external-bridge-runtime';
+import { stopRunLedgerForShutdown } from './runtime-ledger';
+import type { AgentContext } from './context';
+
+for (const fail of [false, true]) {
+  const projectId = `shutdown-${crypto.randomUUID()}`;
+  const draft = makeDraft(docFromTimeline({ ...INITIAL, items: [] }));
+  const context: AgentContext = {
+    commands: draft.commands, getState: draft.getState, getDoc: draft.getDoc,
+    getCreativeMode: () => null, templates: [], audio: [], getProjectId: () => projectId,
+  };
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const runtime = new ExternalBridgeRuntime(projectId, 'shutdown-editor', () => context, () => {}, {
+    saveProject, saveAutomaticVersion,
+    saveExternalProposal: async (id, record) => {
+      entered.resolve(); await release.promise;
+      if (fail) throw new Error('draft checkpoint write failed');
+      await saveExternalProposal(id, record);
+    },
+  });
+  const beginning = runtime.execute('begin_edit_session', {}, runtime.binding());
+  const accepted = fail ? assert.rejects(beginning, /draft checkpoint write failed/) : beginning;
+  await entered.promise;
+  const stopping = runtime.stopForShutdown();
+  const stopped = fail ? assert.rejects(stopping, /Browser edit-session shutdown failed/) : stopping;
+  let finished = false;
+  void stopped.then(() => { finished = true; });
+  assert.strictEqual(stopping, runtime.stopForShutdown());
+  await assert.rejects(runtime.execute('begin_edit_session', {}, runtime.binding()), /shutting down/);
+  await tick(); assert.equal(finished, false);
+  release.resolve(); await accepted; await stopped;
+  if (!fail) {
+    assert.equal((await loadExternalProposal(projectId))?.status, 'drafting');
+    assert.equal((await loadAgentRuntimeSidecar(projectId)).runs[0]?.status, 'running');
+    await runtime.disconnect();
+    assert.equal((await loadExternalProposal(projectId))?.status, 'drafting', 'closing the view does not cancel the saved draft');
+  }
+}
+await stopRunLedgerForShutdown();
+await stopAgentRuntimeWritesForShutdown();
+console.log('external shutdown: accepted checkpoint, failed checkpoint and lease drain passed');
