new file mode 100644
index 0000000..b34a51d
--- /dev/null
+++ b/server/plugins/generation-shutdown.verify.ts
@@ -0,0 +1,97 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtemp, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { setImmediate as tick } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const scenario = process.argv[2];
+if (!scenario) {
+  for (const name of ['accepted', 'task-failure', 'write-failure', 'cleanup', 'unknown-restored']) {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ['--import', 'tsx', fileURLToPath(import.meta.url), name], { stdio: 'inherit' });
+      child.once('error', reject);
+      child.once('close', (code, signal) => code === 0 && signal === null ? resolve() : reject(new Error(`${name}: ${code}/${signal}`)));
+    });
+  }
+  console.log('generation shutdown: 5 isolated process cases passed');
+} else {
+  const root = await mkdtemp(join(tmpdir(), 'mantur-generation-shutdown-'));
+  process.env.OPENCHATCUT_DATA_DIR = root;
+  process.env.OPENCHATCUT_GENERATION_JOB_STORE = join(root, 'ledger', 'jobs.json');
+  process.env.OPENCHATCUT_SQLITE_STORE = '0';
+  try {
+    if (scenario === 'unknown-restored') {
+      process.env.OPENCHATCUT_GENERATION_JOB_STORE = join(root, 'jobs.json');
+      await writeFile(join(root, 'jobs.json'), JSON.stringify({ version: 1, jobs: [{
+        id: 'unconfirmed', status: 'running', progress: 5, params: {},
+        createdAt: Date.now(), updatedAt: Date.now(),
+      }] }));
+    }
+    const lifecycle = await import('./generation-job-lifecycle.ts');
+    const store = await import('./generation-job-store.ts');
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const finalized = Promise.withResolvers<void>();
+    const finishCleanup = Promise.withResolvers<void>();
+    const result = { path: '/uploads/test.mp4', mimeType: 'video/mp4' };
+    if (scenario === 'accepted') {
+      // The cutoff can precede initialization and the actual provider invocation.
+      const submission = lifecycle.createGenerationJob({}, async () => {
+        entered.resolve(); await release.promise; return result;
+      }, { onSettled: async () => { finalized.resolve(); await finishCleanup.promise; } });
+      const stopping = lifecycle.stopGenerationJobsForShutdown();
+      assert.strictEqual(stopping, lifecycle.stopGenerationJobsForShutdown());
+      await assert.rejects(lifecycle.createGenerationJob({}, async () => result), /shutting down/);
+      await entered.promise;
+      const job = await submission;
+      let closed = false;
+      void stopping.then(() => { closed = true; });
+      await tick(); assert.equal(closed, false);
+      release.resolve(); await finalized.promise;
+      assert.equal(lifecycle.getGenerationJobSnapshot(job.jobId)?.status, 'succeeded');
+      await tick(); assert.equal(closed, false, 'status is not the final cleanup promise');
+      finishCleanup.resolve(); await stopping;
+      const saved = JSON.parse(await readFile(process.env.OPENCHATCUT_GENERATION_JOB_STORE!, 'utf8'));
+      assert.equal(saved.jobs[0].status, 'succeeded');
+      await assert.rejects(store.persistJobs(), /shutting down/);
+    } else if (scenario === 'task-failure' || scenario === 'write-failure') {
+      const job = await lifecycle.createGenerationJob({}, async () => {
+        entered.resolve(); await release.promise;
+        if (scenario === 'task-failure') throw new Error('provider failed after acceptance');
+        return result;
+      });
+      await entered.promise;
+      if (scenario === 'write-failure') {
+        await rename(join(root, 'ledger'), join(root, 'original-ledger'));
+        await writeFile(join(root, 'ledger'), 'not a directory');
+      }
+      const stopping = lifecycle.stopGenerationJobsForShutdown();
+      const rejected = assert.rejects(stopping, /Generation shutdown failed/);
+      release.resolve(); await rejected;
+      assert.strictEqual(stopping, lifecycle.stopGenerationJobsForShutdown());
+      assert.equal(lifecycle.getGenerationJobSnapshot(job.jobId)?.status, scenario === 'task-failure' ? 'failed' : 'succeeded');
+    } else if (scenario === 'cleanup') {
+      const job = await lifecycle.createGenerationJob({}, async () => result, {
+        cleanupResult: async () => { entered.resolve(); await release.promise; },
+        onSettled: () => finalized.resolve(),
+      });
+      await finalized.promise;
+      const deleting = lifecycle.deleteGenerationJob(job.jobId);
+      await entered.promise;
+      const stopping = lifecycle.stopGenerationJobsForShutdown();
+      let stopped = false;
+      void stopping.then(() => { stopped = true; });
+      await tick(); assert.equal(stopped, false);
+      release.resolve(); await deleting; await stopping;
+      assert.equal(lifecycle.getGenerationJobSnapshot(job.jobId), undefined);
+    } else {
+      await lifecycle.initializeGenerationJobs();
+      await assert.rejects(lifecycle.stopGenerationJobsForShutdown(), /Generation shutdown failed/);
+      assert.equal(lifecycle.getGenerationJobSnapshot('unconfirmed')?.code, 'submission_unknown');
+    }
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+}
