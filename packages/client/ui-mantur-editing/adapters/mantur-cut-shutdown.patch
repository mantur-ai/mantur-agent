+  const broker = await import('../external-agent/broker.ts');
+  const errors: unknown[] = [];
+  const app = createMiniConnect(error => { errors.push(error); });
+  const server = createServer((req, res) => app.handle(req, res));
+  const owner = new ManturEditorShutdown();
+  try {
+    const mount = async (plugin: Plugin) => {
+      const hook = plugin.configureServer!; const configure = typeof hook === 'function' ? hook : hook.handler;
+      await configure.call({} as never, { middlewares: app, httpServer: server, config: { logger: { error() {}, info() {} } } } as unknown as ViteDevServer);
+    };
+    await mount(owner.plugin());
+    const admitted = Promise.withResolvers<void>();
+    // The actual route returns its original promise; this observation adds no work to it.
+    const observedApp = new Proxy(app, { get(target, key, receiver) {
