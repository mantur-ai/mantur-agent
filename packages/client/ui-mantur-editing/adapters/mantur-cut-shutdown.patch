+    const flush = expectedFailure ? Promise.resolve() : poll().then(async call => {
+      assert.equal(call?.arguments.phase, 'flush'); flushed = true;
+      broker.settleEditorCall(call!.id, 'applied', { phase: 'flush' }, capability);
+      await broker.unregisterEditor('project', 'editor', capability);
+    });
