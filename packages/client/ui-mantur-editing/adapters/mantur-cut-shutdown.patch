+    }
+    return nativeRm(path, options);
+  };
+  syncBuiltinESMExports();
+  const { createMiniConnect } = await import('../../desktop/mini-connect.ts');
+  const { ManturEditorShutdown } = await import('./mantur-shutdown.ts');
+  const { extractFramesPlugin } = await import('./extract-frames.ts');
+  const broker = await import('../external-agent/broker.ts');
+  const errors: unknown[] = [];
+  const app = createMiniConnect(error => { errors.push(error); });
+  const server = createServer((req, res) => app.handle(req, res));
+  const owner = new ManturEditorShutdown();
+  try {
+    const mount = async (plugin: Plugin) => {
+      const hook = plugin.configureServer!; const configure = typeof hook === 'function' ? hook : hook.handler;
+      await configure.call({} as never, { middlewares: app, httpServer: server, config: { logger: { error() {}, info() {} } } } as unknown as ViteDevServer);
+    };
+    await mount(owner.plugin());
+    const admitted = Promise.withResolvers<void>();
+    // The actual route returns its original promise; this observation adds no work to it.
+    const observedApp = new Proxy(app, { get(target, key, receiver) {
+      if (key !== 'use') return Reflect.get(target, key, receiver);
+      return (path: string, handler: Parameters<typeof app.use>[1]) => target.use(path, (req, res, next) => {
+        const result = handler!(req, res, next); admitted.resolve(); return result;
+      });
+    } });
+    const plugin = owner.ownPlugin(extractFramesPlugin());
+    const hook = plugin.configureServer!; const configure = typeof hook === 'function' ? hook : hook.handler;
+    await configure.call({} as never, { middlewares: observedApp, httpServer: server, config: { logger: { error() {}, info() {} } } } as unknown as ViteDevServer);
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address(); assert(address && typeof address !== 'string');
+    const url = `http://127.0.0.1:${address.port}/api/extract-frames`;
+    let post!: ReturnType<typeof request>;
+    const response = new Promise<{ status: number; body: Record<string, unknown> }>((resolve, reject) => {
+      post = request(url, { method: 'POST', headers: { 'Content-Type': 'application/json' } }, res => {
+        const chunks: Buffer[] = []; res.on('data', chunk => chunks.push(chunk));
+        res.on('end', () => { resolve({ status: res.statusCode!, body: JSON.parse(Buffer.concat(chunks).toString()) }); });
+        res.on('error', reject);
+      });
+      post.on('error', reject); post.write('{"src":');
+    });
+    let responded = false; void response.then(() => { responded = true; });
+    await admitted.promise;
+    const capability = broker.registerEditor('project', 'editor', 'revision', []);
+    const stopping = owner.stopForShutdown();
+    const observed = stopping.then(() => ({ ok: true as const }), error => ({ ok: false as const, error }));
+    const poll = () => broker.nextEditorCall('project', 'editor', 'revision', AbortSignal.timeout(10000), capability);
+    const freeze = await poll(); assert.equal(freeze?.arguments.phase, 'freeze');
+    broker.settleEditorCall(freeze!.id, 'applied', { phase: 'freeze' }, capability);
+    await tick();
+    assert.equal((await fetch(url, { method: 'POST', body: '{}' })).status, 503, 'new extraction is refused after cutoff');
+    const body = scenario === 'automatic' || scenario === 'scene-failure' ? { src: '/media/uploads/fresh-test.mp4', count: 2 } : { src: '/media/uploads/fresh-test.mp4', sourceTimesMs: [0, 200] };
+    post.end(JSON.stringify(body).slice('{"src":'.length));
+    let finished = false; void observed.then(() => { finished = true; });
+    if (scenario === 'pipe') {
+      const child = await pipeEntered.promise;
+      await new Promise<void>(resolve => child.once('exit', () => resolve()));
+      await tick(); assert.equal(finished, false, 'process exit is insufficient while its stderr is inherited');
+      assert.equal(responded, false, 'frame extraction still awaits its actual child close before replying');
+      await writeFile(releaseFile, 'release');
+    }
+    const result = await response;
+    if (scenario === 'grid-cleanup-failure') {
+      assert.equal(result.status, 500); assert.match(String(result.body.error), /grid cleanup refused/);
+    } else {
+      assert.equal(result.status, 200, JSON.stringify(result.body));
+      assert.equal(result.body.renderedBy, 'ffmpeg');
+      const jpeg = Buffer.from(String(result.body.base64), 'base64');
+      assert.equal(jpeg.subarray(0, 2).toString('hex'), 'ffd8');
+      assert.equal(jpeg.subarray(-2).toString('hex'), 'ffd9');
+      await writeFile(join(root, 'contact-sheet.jpg'), jpeg);
+      execFileSync(ffmpeg, ['-nostdin', '-v', 'error', '-i', join(root, 'contact-sheet.jpg'), '-f', 'null', '-'], { timeout: 15000 });
+      assert.deepEqual(await readFile(join(root, 'contact-sheet.jpg')), jpeg);
+    }
+    assert.deepEqual(await readFile(video), originalVideo, 'source video is never modified');
+    await cleanupEntered.promise; await tick(); assert.equal(finished, false, 'HTTP response does not finish temporary-file cleanup');
