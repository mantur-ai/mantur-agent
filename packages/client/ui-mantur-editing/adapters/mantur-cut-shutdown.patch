@@ -0,0 +1,43 @@
+/** Expose the exact child-process close event in pinned Remotion 4.0.509. */
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const patches = [
+  { file: 'browser/BrowserRunner.js', indent: '    ', comma: ',',
+    original: 'e5401a2f9ddacefd34814025ce2a26c378584cab31237b1655d74c880e07adfe',
+    patched: '3f32af1d0140b3f3316e50330e7bd900ab4ef16f2738b5634455f484d16c26ae' },
+  { file: 'esm/index.mjs', indent: '  ', comma: '',
+    original: 'f9604c14bb917e263c9e79c85044b681d1da41df5b5b8ae586a6f2e4b7050413',
+    patched: '465ca13edf1f61d2a3524741523a47733bcbe2a6c65a5a29cf81a0119eb4c866' },
+];
+const digest = source => createHash('sha256').update(source).digest('hex');
+
+/** Apply only to the reviewed source bytes; an unknown dependency version fails closed. */
+export function patchRemotionShutdown(source) {
+  const hash = digest(source);
+  const patch = patches.find(entry => entry.original === hash || entry.patched === hash);
+  if (!patch) throw new Error('Unrecognized Remotion BrowserRunner; review the shutdown patch before building');
+  if (hash === patch.patched) return source;
+  const { indent, comma } = patch;
+  const patched = source.replace(
+    `${indent}const browserWSEndpoint = await waitForWSEndpoint({`,
+    `${indent}const manturProcessAndPipesClosed = new Promise((resolve) => {\n${indent}${indent}proc.once("close", () => resolve());\n${indent}});\n${indent}const browserWSEndpoint = await waitForWSEndpoint({`,
+  ).replace(`${indent}${indent}closeProcess${comma}\n${indent}};\n};`, `${indent}${indent}closeProcess,\n${indent}${indent}manturProcessAndPipesClosed${comma}\n${indent}};\n};`);
+  if (digest(patched) !== patch.patched) throw new Error('Remotion shutdown patch did not produce the reviewed source');
+  return patched;
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const require = createRequire(import.meta.url);
+  const root = dirname(require.resolve('@remotion/renderer'));
+  const plans = await Promise.all(patches.map(async ({ file }) => {
+    const path = join(root, file);
+    const source = await readFile(path, 'utf8');
+    return { path, source, patched: patchRemotionShutdown(source) };
+  }));
+  for (const { path, source, patched } of plans) if (patched !== source) await writeFile(path, patched);
+  console.log('Remotion 4.0.509 process-and-pipe close evidence patch verified');
+}
