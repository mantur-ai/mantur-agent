--- /dev/null
+++ b/remotion/audio-finalization.mjs
@@ -0,0 +1,130 @@
+/** Preserve PCM timing until the single AAC encode into the final MP4 container. */
+import { spawn } from 'node:child_process';
+import { mkdtemp, mkdir, open, rename, rm } from 'node:fs/promises';
+import path from 'node:path';
+import { VERSION } from 'remotion/version';
+
+/** Report the failed audio stage and whether its private files were removed. */
+export class AudioFinalizationError extends Error {
+  constructor(cause, stage, cleanupStatus) {
+    super(`H.264 audio ${stage} failed: ${cause.message}`, { cause });
+    this.name = 'AudioFinalizationError';
+    this.stage = stage;
+    this.cleanupStatus = cleanupStatus;
+  }
+}
+
+/** True only for the existing ordinary H.264/AAC path, excluding explicit mute. */
+export function usesPcmFinalization(options, directBinaries) {
+  return options.codec === 'h264' && !options.muted && !directBinaries
+    && !options.separateAudioTo && (!options.audioCodec || options.audioCodec === 'aac');
+}
+
+/** Await the owned process's exit on success, failure, timeout, and cancellation. */
+async function runMediaTool(command, args, signal, timeoutMs) {
+  signal?.throwIfAborted();
+  if (!command) throw new Error('The configured media executable is missing');
+  return new Promise((resolve, reject) => {
+    const env = Object.fromEntries(Object.entries(process.env)
+      .filter(([key]) => !/(?:KEY|SECRET|TOKEN|PASSWORD)/i.test(key)));
+    const child = spawn(command, args, { stdio: ['ignore', 'pipe', 'pipe'], env });
+    let stdout = '';
+    let stderr = '';
+    let failure;
+    const stop = (error) => {
+      failure ??= error;
+      child.kill('SIGKILL');
+    };
+    const abort = () => stop(signal.reason instanceof Error ? signal.reason : new Error('Export cancelled'));
+    signal?.addEventListener('abort', abort, { once: true });
+    if (signal?.aborted) abort();
+    const timer = setTimeout(() => stop(new Error('Media process timed out')), timeoutMs);
+    child.stdout.on('data', (chunk) => {
+      stdout += chunk.toString();
+      if (stdout.length > 131_072) stop(new Error('Media process output exceeds 128 KiB'));
+    });
+    child.stderr.on('data', (chunk) => { stderr = `${stderr}${chunk}`.slice(-32_768); });
+    child.once('error', (error) => { failure ??= error; });
+    child.once('close', (code) => {
+      clearTimeout(timer);
+      signal?.removeEventListener('abort', abort);
+      if (failure) reject(failure);
+      else if (code !== 0) reject(new Error(`Media process exited ${code}: ${stderr}`));
+      else resolve({ stdout, stderr });
+    });
+  });
+}
+
+/**
+ * Render the video (including its existing retries), then finalize audio outside them.
+ * @param {object} request Render callback, resolved media binaries, options and cancellation.
+ * @returns {Promise<object>} The original render result after the final MP4 is published.
+ * @throws {AudioFinalizationError} Preflight, render, encode, or cleanup failure; never retries audio.
+ */
+export async function finalizeH264Audio({ render, options, binaries, signal, onStage }) {
+  let stage = 'preflight';
+  let directory;
+  let result;
+  let failure;
+  let cleanupStatus = 'succeeded';
+  try {
+    onStage?.(stage);
+    signal?.throwIfAborted();
+    if (VERSION !== '4.0.509') throw new Error(`Audio export requires verified Remotion 4.0.509; found ${VERSION}`);
+    if (!binaries?.ffmpeg || !binaries?.ffprobe) throw new Error('H.264 export requires resolved FFmpeg and FFprobe paths');
+    if (!options.outputLocation) throw new Error('H.264 audio finalization requires an output file');
+    const timeoutMs = options.timeoutInMilliseconds;
+    if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new Error('H.264 export requires a positive media timeout');
+    const tool = (command, args) => runMediaTool(command, args, signal, timeoutMs);
+    const encoder = await tool(binaries.ffmpeg, ['-hide_banner', '-h', 'encoder=aac']);
+    if (!/^Encoder aac\s/m.test(`${encoder.stdout}\n${encoder.stderr}`)) {
+      throw new Error('The configured FFmpeg does not provide the native AAC encoder');
+    }
+    await tool(binaries.ffprobe, ['-version']);
+    const destination = path.resolve(options.outputLocation);
+    await mkdir(path.dirname(destination), { recursive: true });
+    directory = await mkdtemp(path.join(path.dirname(destination), '.mantur-audio-'));
+    const video = path.join(directory, 'video.mp4');
+    const audio = path.join(directory, 'audio.wav');
+    const output = path.join(directory, 'final.mp4');
+    stage = 'render';
+    onStage?.(stage);
+    result = await render({ ...options, outputLocation: video, audioCodec: 'pcm-16', separateAudioTo: audio });
+    signal?.throwIfAborted();
+    stage = 'encode';
+    onStage?.(stage);
+    const probe = await tool(binaries.ffprobe, [
+      '-v', 'error', '-select_streams', 'a:0', '-show_entries', 'stream=codec_name,sample_rate', '-of', 'json', audio,
+    ]);
+    const stream = JSON.parse(probe.stdout).streams?.[0];
+    const sampleRate = Number(stream?.sample_rate);
+    if (stream?.codec_name !== 'pcm_s16le' || !Number.isSafeInteger(sampleRate) || sampleRate <= 0) {
+      throw new Error('Rendered audio must be PCM16 with a valid sample rate');
+    }
+    await tool(binaries.ffmpeg, [
+      '-hide_banner', '-y', '-i', video, '-i', audio,
+      '-map', '0:v:0', '-map', '1:a:0', '-c:v', 'copy', '-c:a', 'aac',
+      '-b:a', options.audioBitrate ?? '320k', '-movie_timescale', String(sampleRate),
+      '-movflags', '+faststart', output,
+    ]);
+    const file = await open(output, 'r');
+    try {
+      if ((await file.stat()).size === 0) throw new Error('Audio finalization produced an empty MP4');
+      await file.sync();
+    } finally { await file.close(); }
+    signal?.throwIfAborted();
+    await rename(output, destination);
+  } catch (error) {
+    failure = error;
+  } finally {
+    if (directory) {
+      try { await rm(directory, { recursive: true, force: true }); }
+      catch (error) {
+        cleanupStatus = 'failed';
+        failure = failure ? new AggregateError([failure, error], failure.message) : error;
+      }
+    }
+  }
+  if (failure) throw new AudioFinalizationError(failure, stage, cleanupStatus);
+  return result;
+}
