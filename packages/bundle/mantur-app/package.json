{
  "name": "@deepseek-ai/dsh-mantur-app",
  "description": "The Mantur Agent desktop profile layer over dsh-base and dsh-web-app",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/mantur-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-authorization-manturhub": "workspace:^",
    "@deepseek-ai/dsh-client-ui-brand-mantur": "workspace:^",
    "@deepseek-ai/dsh-client-ui-mantur-account": "workspace:^",
    "@deepseek-ai/dsh-client-ui-mantur-navigation": "workspace:^",
    "@deepseek-ai/dsh-manturhub-marketplace": "workspace:^",
    "@deepseek-ai/dsh-mantur-projects": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-client-ui-mantur-editing": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "js-yaml": "^4.1.1"
  }
}
