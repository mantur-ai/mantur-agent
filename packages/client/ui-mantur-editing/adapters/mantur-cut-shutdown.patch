--- /dev/null
+++ b/src/agent/external-shutdown.ts
@@ -0,0 +1,50 @@
+import { flushSync } from 'react-dom';
+import { EDITOR_SHUTDOWN_CALL, type EditorShutdownPhase } from '../../shared/editor-shutdown';
+import {
+  freezeEditorInputForShutdown, stopEditorBackgroundForShutdown, flushEditorForShutdown,
+} from '../editor/mantur-shutdown';
+import { stopAgentRuntimeWritesForShutdown } from '../persist/agentRuntimeStore';
+import { stopJobRegistryWritesForShutdown } from '../persist/jobRegistryStore';
+import { flushChatWrites, flushProjectSaves } from '../persist/projectStore';
+import { stopRunLedgerForShutdown } from './runtime-ledger';
+import type { ExternalBridgeRuntime } from './external-bridge-runtime';
+import type { ExternalCall } from './externalBridgePayload';
+
+const phases = new Map<EditorShutdownPhase, Promise<{ phase: EditorShutdownPhase }>>();
+
+/** Handle Host-only lifecycle control on the original editor poll/result channel. */
+export function executeEditorShutdown(call: ExternalCall, runtime: ExternalBridgeRuntime): Promise<{ phase: EditorShutdownPhase }> {
+  const phase = call.arguments.phase;
+  if (call.name !== EDITOR_SHUTDOWN_CALL || (phase !== 'freeze' && phase !== 'flush')) {
+    return Promise.reject(new Error('Invalid editor shutdown control'));
+  }
+  const binding = runtime.binding();
+  if (call.binding.projectId !== binding.projectId || call.binding.editorInstanceId !== binding.editorInstanceId) {
+    return Promise.reject(new Error('Editor shutdown identity changed'));
+  }
+  const existing = phases.get(phase);
+  if (existing) return existing;
+  const result: Promise<{ phase: EditorShutdownPhase }> = (async () => {
+    if (phase === 'freeze') {
+      freezeEditorInputForShutdown();
+      await runtime.stopForShutdown();
+      await stopEditorBackgroundForShutdown();
+      flushSync(() => {});
+    } else {
+      const prepared = phases.get('freeze');
+      if (!prepared) throw new Error('Editor save requires completed input and operation cutoff');
+      await prepared;
+      flushSync(() => {});
+      await flushEditorForShutdown(binding.projectId);
+      await stopRunLedgerForShutdown();
+      await stopAgentRuntimeWritesForShutdown();
+      await stopJobRegistryWritesForShutdown();
+      await flushChatWrites(binding.projectId);
+      const saved = await flushProjectSaves(binding.projectId);
+      if (!saved.ok) throw new Error('Editor project saving is unconfirmed');
+    }
+    return { phase };
+  })();
+  phases.set(phase, result);
+  return result;
+}
