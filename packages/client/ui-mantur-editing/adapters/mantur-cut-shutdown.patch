diff --git a/server/media-process-shutdown.verify.ts b/server/media-process-shutdown.verify.ts
new file mode 100644
index 0000000..e3d6e48
--- /dev/null
+++ b/server/media-process-shutdown.verify.ts
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { basename } from 'node:path';
+import { trackEditorMediaProcess, stopEditorMediaProcessesForShutdown } from './shutdown-runtime.ts';
+
+const child = trackEditorMediaProcess(spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], {
+  stdio: 'ignore', env: {},
+}), 'synthetic signal probe');
+const closed = once(child, 'close');
+try {
+  await once(child, 'spawn');
+  assert.equal(child.kill('SIGKILL'), true);
+  await closed;
+  await assert.rejects(stopEditorMediaProcessesForShutdown(), error => {
+    assert(error instanceof AggregateError);
+    assert.equal(error.errors.length, 1);
+    const failure: unknown = error.errors[0];
+    assert(failure instanceof Error);
+    assert(failure.message.includes('synthetic signal probe'));
+    assert(failure.message.includes(basename(process.execPath)));
+    assert(failure.message.includes(`pid ${child.pid}`));
+    assert(failure.message.includes('SIGKILL'));
+    assert(!failure.message.includes('setInterval'));
+    return true;
+  });
+} finally {
+  if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
+  await closed;
+}
+console.log('Media shutdown retains a signaled child failure with operation, basename and PID only');
